///|
// Translate pinned RE2 Unicode 15.0 reference data, preserving its license.
//
// Source: google/re2 tag 2023-09-01. SQL behavior is verified independently by
// harness/corpus/sql2025/regex-properties.sql; these tables are not test oracles.
//
//   moon run scripts/gen-regex-unicode.mbtx    (from the repo root; then moon fmt)

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/string",
}

///|
const VENDOR = "docs/reference/vendor/re2"

///|
/// Python `Path.read_text()` of an ASCII C source. The hand-written matchers
/// below treat `\w` and `\d` as ASCII, so non-ASCII input is refused rather
/// than matched differently from Python's Unicode classes.
async fn read_ascii(path : String) -> String {
  let text = @fs.read_file(path).text()
  if text.iter().any(c => c.to_int() > 0x7F) {
    fail("\{path}: non-ASCII input; extend the matchers first")
  }
  text.replace_all(old="\r\n", new="\n").replace_all(old="\r", new="\n")
}

///|
/// A pattern did not match at the tried position.
suberror NoMatch

///|
fn unit(s : String, i : Int) -> Int {
  if i < s.length() {
    s.at(i).to_int()
  } else {
    -1
  }
}

///|
/// The literal `p` at `i`: the position after it.
fn lit(s : String, i : Int, p : String) -> Int raise NoMatch {
  for k in 0..<p.length() {
    if unit(s, i + k) != p.at(k).to_int() {
      raise NoMatch
    }
  }
  i + p.length()
}

///|
/// A non-empty greedy run of units accepted by `ok` at `i`.
fn run(s : String, i : Int, ok : (Int) -> Bool) -> (String, Int) raise NoMatch {
  let mut j = i
  while ok(unit(s, j)) {
    j += 1
  }
  if j == i {
    raise NoMatch
  }
  (s.unsafe_substring(start=i, end=j), j)
}

///|
fn is_digit(u : Int) -> Bool {
  u >= '0'.to_int() && u <= '9'.to_int()
}

///|
fn is_word(u : Int) -> Bool {
  is_digit(u) ||
  (u >= 'a'.to_int() && u <= 'z'.to_int()) ||
  (u >= 'A'.to_int() && u <= 'Z'.to_int()) ||
  u == '_'.to_int()
}

///|
/// Python `re.findall` with a matcher returning the groups and the end.
fn findall(
  s : String,
  try_at : (String, Int) -> (Array[String], Int) raise NoMatch,
) -> Array[Array[String]] {
  let out = []
  let mut i = 0
  while i <= s.length() {
    try try_at(s, i) catch {
      NoMatch => i += 1
    } noraise {
      (groups, end) => {
        out.push(groups)
        i = if end == i { i + 1 } else { end }
      }
    }
  }
  out
}

///|
/// `static const URange(?:16|32) (\w+)\[\] = \{(.*?)\};` with re.S.
fn range_table(s : String, i : Int) -> (Array[String], Int) raise NoMatch {
  let i = lit(s, i, "static const URange")
  let i = lit(s, i, "16") catch { NoMatch => lit(s, i, "32") }
  let (name, i) = run(s, lit(s, i, " "), is_word)
  let start = lit(s, i, "[] = {")
  guard s.view(start_offset=start).find("};") is Some(len) else {
    raise NoMatch
  }
  ([name, s.unsafe_substring(start~, end=start + len)], start + len + 2)
}

///|
/// `\{ (\d+), (\d+) \}`
fn range_pair(s : String, i : Int) -> (Array[String], Int) raise NoMatch {
  let (a, i) = run(s, lit(s, i, "{ "), is_digit)
  let (b, i) = run(s, lit(s, i, ", "), is_digit)
  ([a, b], lit(s, i, " }"))
}

///|
/// `\{ "([^"]+)", \+1, (\w+), \d+, (\w+), \d+ \}`
fn group_entry(s : String, i : Int) -> (Array[String], Int) raise NoMatch {
  let (name, i) = run(s, lit(s, i, "{ \""), u => u >= 0 && u != '"'.to_int())
  let (r16, i) = run(s, lit(s, i, "\", +1, "), is_word)
  let (_, i) = run(s, lit(s, i, ", "), is_digit)
  let (r32, i) = run(s, lit(s, i, ", "), is_word)
  let (_, i) = run(s, lit(s, i, ", "), is_digit)
  ([name, r16, r32], lit(s, i, " }"))
}

///|
/// `\{ (\d+), (\d+), ([\w-]+) \}`
fn fold_entry(s : String, i : Int) -> (Array[String], Int) raise NoMatch {
  let (a, i) = run(s, lit(s, i, "{ "), is_digit)
  let (b, i) = run(s, lit(s, i, ", "), is_digit)
  let (d, i) = run(s, lit(s, i, ", "), u => is_word(u) || u == '-'.to_int())
  ([a, b, d], lit(s, i, " }"))
}

///|
/// Python `int()` of a `\d+` match: drops leading zeros.
fn py_int(digits : String) -> String raise {
  @string.parse_int(digits).to_string()
}

///|
/// Python `text.split(sep)[index]`.
fn split_part(text : String, sep : String, index : Int) -> String raise {
  let parts = text.split(sep).collect()
  guard parts.get(index) is Some(part) else {
    fail("separator \{sep} not found")
  }
  part.to_owned()
}

///|
async fn main {
  if !@fs.exists("scripts/gen-regex-unicode.mbtx") {
    fail("run from the repo root: moon run scripts/gen-regex-unicode.mbtx")
  }
  let text = read_ascii("\{VENDOR}/unicode_groups.cc")
  let ranges : Map[String, Array[(String, String)]] = Map([])
  for table in findall(text, range_table) {
    ranges[table[0]] = findall(table[1], range_pair).map(p => {
      (py_int(p[0]), py_int(p[1]))
    })
  }
  let lines = [
    "// Generated by scripts/gen-regex-unicode.mbtx. RE2 Unicode 15.0 tables.", "// Copyright The RE2 Authors. BSD license: docs/reference/vendor/re2/LICENSE.",
    "", "///|", "/// name:lo,hi,lo,hi,... per Unicode group (text: decoded on first use,",
    "/// see @tabletext). The first entry of a name wins.", "let unicode_range_text : String =",
  ]
  for entry in findall(text, group_entry) {
    let rows = ranges.get(entry[1]).unwrap_or([]) +
      ranges.get(entry[2]).unwrap_or([])
    let body = rows.map(r => "\{r.0},\{r.1}").join(",")
    lines.push("  #|\{entry[0]}:" + body)
  }
  lines.push_iter(
    [
      "", "///|", "let unicode_range_table : Ref[Map[String, Array[(Int, Int)]]?] = Ref(None)",
      "", "///|", "fn unicode_ranges(name : String) -> Array[(Int, Int)]? {", "  if name == \"Any\" {",
      "    return Some([(0, 0x10FFFF)])", "  }", "  let table = match unicode_range_table.val {",
      "    Some(table) => table", "    None => {", "      let table : Map[String, Array[(Int, Int)]] = Map([])",
      "      for line in unicode_range_text.split(\"\\n\") {", "        guard line.split_once(\":\") is Some((key, body)) else { continue }",
      "        let key = key.to_owned()", "        if table.contains(key) {", "          continue",
      "        }", "        let flat = body.split(\",\").map(@tabletext.int).collect()",
      "        table[key] = Array::makei(flat.length() / 2, i => (flat[2 * i], flat[2 * i + 1]))",
      "      }", "      unicode_range_table.val = Some(table)", "      table", "    }",
      "  }", "  // a copy: callers own the ranges they get", "  table.get(name).map(ranges => ranges.copy())",
      "}", "", "///|", "/// lo,hi,delta per case-fold range, sorted.", "let unicode_fold_text : String =",
    ].iter(),
  )
  let body = split_part(
    split_part(
      read_ascii("\{VENDOR}/unicode_casefold.cc"),
      "const CaseFold unicode_casefold[] = {",
      1,
    ),
    "};",
    0,
  )
  for fold in findall(body, fold_entry) {
    let d = match fold[2] {
      "EvenOdd" => "2000000"
      "OddEven" => "2000001"
      d => d
    }
    lines.push("  #|\{fold[0]},\{fold[1]},\{d}")
  }
  lines.push_iter(
    [
      "", "///|", "let unicode_fold_table : Ref[Array[(Int, Int, Int)]?] = Ref(None)",
      "", "///|", "fn unicode_fold_ranges() -> Array[(Int, Int, Int)] {", "  if unicode_fold_table.val is Some(table) {",
      "    return table", "  }", "  let table = @tabletext.int_rows(unicode_fold_text).map(r => (r[0], r[1], r[2]))",
      "  unicode_fold_table.val = Some(table)", "  table", "}", "", "///|", "fn unicode_fold(value : Int) -> Int {",
      "  let ranges = unicode_fold_ranges()", "  let mut low = 0", "  let mut high = ranges.length()",
      "  while low < high {", "    let mid = low + (high - low) / 2", "    let (a, b, delta) = ranges[mid]",
      "    if value < a { high = mid } else if value > b { low = mid + 1 } else {",
      "      return match delta {", "        2000000 => value ^ 1", "        2000001 => ((value - 1) ^ 1) + 1",
      "        _ => value + delta", "      }", "    }", "  }", "  value", "}",
    ].iter(),
  )
  @fs.write_file("src/core/regex/unicode_data.mbt", lines.join("\n") + "\n")
}
