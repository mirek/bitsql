///|
// Generate seed selection assertions from captured build_parameters.
//
//   moon run scripts/gen-vector-seed-tests.mbtx
//
// Writes src/core/store/vector_seed_test.mbt; run `moon fmt` afterwards.
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
const CORPUS = "harness/corpus/sql2025"

///|
/// Python `json.dumps(str)` (`ensure_ascii=True`): UTF-16 `\uXXXX` escapes.
fn py_str(s : String) -> String {
  let out = StringBuilder()
  out.write_char('"')
  for unit in s.code_units() {
    match unit.to_int() {
      0x22 => out.write_string("\\\"")
      0x5C => out.write_string("\\\\")
      0x0A => out.write_string("\\n")
      0x0D => out.write_string("\\r")
      0x09 => out.write_string("\\t")
      0x08 => out.write_string("\\b")
      0x0C => out.write_string("\\f")
      u if u < 0x20 || u > 0x7E =>
        out.write_string("\\u" + u.to_string(radix=16).pad_start(4, '0'))
      u => out.write_char(u.unsafe_to_char())
    }
  }
  out.write_char('"')
  out.to_string()
}

///|
/// Python `str.title()`: upper-case each letter that follows a non-letter.
fn py_title(s : String) -> String {
  let out = StringBuilder()
  let mut after_letter = false
  for c in s {
    out.write_char(
      if after_letter {
        c.to_ascii_lowercase()
      } else {
        c.to_ascii_uppercase()
      },
    )
    after_letter = c.is_ascii_alphabetic()
  }
  out.to_string()
}

///|
/// The text Python prints for a captured integer. Captures are written by
/// JavaScript, so a number is integer-shaped (a Python `int`) exactly when it
/// is integral and below 1e21; larger integer literals keep their source text.
fn int_text(j : Json) -> String raise {
  match j {
    Number(_, repr=Some(t)) if t.iter().all(c => c == '-' || c.is_ascii_digit()) =>
      t
    Number(d, repr=None) if d == d.floor() && d.abs() < 1.0e21 =>
      d.to_int64().to_string()
    _ => fail("expected an integer, got \{j.stringify()}")
  }
}

///|
/// Python `str()` of a decoded JSON scalar, as an f-string prints it
/// (non-integer numbers never reach it here, so they fail).
fn py_text(j : Json) -> String raise {
  match j {
    String(s) => s
    Null => "None"
    True => "True"
    False => "False"
    _ => int_text(j)
  }
}

///|
fn key(j : Json, name : String) -> Json raise {
  guard j is Object(fields) && fields.get(name) is Some(v) else {
    fail("missing key \{name}")
  }
  v
}

///|
fn idx(j : Json, i : Int) -> Json raise {
  guard j is Array(items) && items.get(i) is Some(v) else {
    fail("missing index \{i}")
  }
  v
}

///|
fn arr(j : Json) -> Array[Json] raise {
  guard j is Array(items) else { fail("expected an array") }
  items
}

///|
fn str(j : Json) -> String raise {
  guard j is String(s) else { fail("expected a string") }
  s
}

///|
fn rows(step : Json, set : Int) -> Array[Json] raise {
  arr(key(idx(key(step, "sets"), set), "rows"))
}

///|
async fn read_json(path : String) -> Json {
  @json.parse(@fs.read_file(path).text())
}

///|
/// The first capture group of the first match, like `re.search(...)[1]`.
fn search(pattern : String, text : String) -> String raise {
  guard @string.Regex(pattern).execute(text) is Some(m) else {
    fail("no match for \{pattern}")
  }
  m.group(1).unwrap().to_owned()
}

///|
async fn main {
  if !@fs.exists("scripts/gen-vector-seed-tests.mbtx") {
    fail(
      "run from the repository root: moon run scripts/gen-vector-seed-tests.mbtx",
    )
  }
  let lines = [
    "// Generated by scripts/gen-vector-seed-tests.mbtx from oracle captures.", "",
  ]
  let input_pattern = @string.Regex("\\((-?[0-9]+),'(\\[[^']+\\])'\\)")
  for file in ["vector-seed"] {
    let cases = arr(key(read_json("\{CORPUS}/\{file}.cases.json"), "cases"))
    let expected = key(read_json("\{CORPUS}/\{file}.expected.json"), "cases")
    for case in cases {
      let name = str(key(case, "name"))
      let steps = arr(key(key(expected, name), "steps"))
      for s in steps {
        guard arr(key(s, "errors")).is_empty() else { fail("\{file} \{name}") }
      }
      let sqls = arr(key(case, "steps")).map(s => str(key(s, "sql")))
      guard sqls.search_by(s => s.has_prefix("CREATE VECTOR INDEX"))
        is Some(ddl) else {
        fail("\{name}: no CREATE VECTOR INDEX step")
      }
      let setup = sqls[:ddl].join(" ")
      let metric = py_title(search("METRIC='([A-Za-z0-9_]+)'", sqls[ddl]))
      let dims = @string.parse_int(search("vector\\(([0-9]+)", setup))
      let base = if setup.contains(",float16)") {
        ", base=@types.Float16"
      } else {
        ""
      }
      let params = @json.parse(str(idx(rows(steps[ddl + 1], 0)[0], 0)))
      let start = py_text(key(params, "StartId"))
      lines.append([
        "///|",
        "test \"vector seed oracle \{name}\" {",
        "  let input : Array[(Int, @types.VectorData)] = [",
      ])
      for m in input_pattern.find(setup) {
        let input_key = m.group(1).unwrap()
        let vector = m.group(2).unwrap().to_owned()
        lines.push(
          "    (\{input_key}, @types.vector_parse(\{py_str(vector)}, \{dims}\{base})),",
        )
      }
      lines.append([
        "  ]",
        "  input.sort_by((a, b) => a.0.compare(b.0))",
        "  assert_eq(@store.vector_seed(input, @store.\{metric}), Some(\{start}))",
        "}",
        "",
      ])
    }
  }
  @fs.write_file("src/core/store/vector_seed_test.mbt", lines.join("\n"))
}
