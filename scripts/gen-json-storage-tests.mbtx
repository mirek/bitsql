///|
// Generate native JSON construction-size tests from SQL Server captures.
//
//   moon run scripts/gen-json-storage-tests.mbtx
//
// Writes src/core/types/json_storage_oracle_test.mbt; run `moon fmt` afterwards.
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
const CORPUS = "harness/corpus/sql2025"

///|
/// Python `json.dumps(str, ensure_ascii=...)`; ASCII mode escapes every
/// non-ASCII UTF-16 unit as `\uXXXX`.
fn py_str(s : String, ascii? : Bool = true) -> String {
  let out = StringBuilder()
  out.write_char('"')
  for unit in s.code_units() {
    match unit.to_int() {
      0x22 => out.write_string("\\\"")
      0x5C => out.write_string("\\\\")
      0x0A => out.write_string("\\n")
      0x0D => out.write_string("\\r")
      0x09 => out.write_string("\\t")
      0x08 => out.write_string("\\b")
      0x0C => out.write_string("\\f")
      u if u < 0x20 || (ascii && u > 0x7E) =>
        out.write_string("\\u" + u.to_string(radix=16).pad_start(4, '0'))
      u => out.write_char(u.unsafe_to_char())
    }
  }
  out.write_char('"')
  out.to_string()
}

///|
/// Python `json.dumps(text, ensure_ascii=False)` of a captured canonical
/// document (a string, or `null`).
fn py_text_literal(j : Json) -> String raise {
  match j {
    String(s) => py_str(s, ascii=false)
    Null => "null"
    _ => fail("expected captured JSON text, got \{j.stringify()}")
  }
}

///|
/// The first row of result set `set` in a captured step.
fn first_row(step : Json, set : Int) -> Array[Json] raise {
  arr(idx(key(idx(key(step, "sets"), set), "rows"), 0))
}

///|
/// The text Python prints for a captured integer. Captures are written by
/// JavaScript, so a number is integer-shaped (a Python `int`) exactly when it
/// is integral and below 1e21; larger integer literals keep their source text.
fn int_text(j : Json) -> String raise {
  match j {
    Number(_, repr=Some(t)) if t.iter().all(c => c == '-' || c.is_ascii_digit()) =>
      t
    Number(d, repr=None) if d == d.floor() && d.abs() < 1.0e21 =>
      d.to_int64().to_string()
    _ => fail("expected an integer, got \{j.stringify()}")
  }
}

///|
/// Python `str()` of a decoded JSON scalar, as an f-string prints it
/// (non-integer numbers never reach it here, so they fail).
fn py_text(j : Json) -> String raise {
  match j {
    String(s) => s
    Null => "None"
    True => "True"
    False => "False"
    _ => int_text(j)
  }
}

///|
fn key(j : Json, name : String) -> Json raise {
  guard j is Object(fields) && fields.get(name) is Some(v) else {
    fail("missing key \{name}")
  }
  v
}

///|
fn idx(j : Json, i : Int) -> Json raise {
  guard j is Array(items) && items.get(i) is Some(v) else {
    fail("missing index \{i}")
  }
  v
}

///|
fn arr(j : Json) -> Array[Json] raise {
  guard j is Array(items) else { fail("expected an array") }
  items
}

///|
fn str(j : Json) -> String raise {
  guard j is String(s) else { fail("expected a string") }
  s
}

///|
async fn read_json(path : String) -> Json {
  @json.parse(@fs.read_file(path).text())
}

///|
/// Compact input builder emitted into the generated file; it mirrors the
/// generated SQL documents.
let keys_builder : String =
  #|
  #|///|
  #|fn json_storage_keys(n : Int, array_objects? : Bool = false) -> String {
  #|  let out = StringBuilder()
  #|  out.write_string(if array_objects { "[" } else { "{" })
  #|  for i in 0..<n {
  #|    if i > 0 { out.write_string(",") }
  #|    if array_objects { out.write_string("{") }
  #|    out.write_string("\"k\{i}\":0")
  #|    if array_objects { out.write_string("}") }
  #|  }
  #|  out.write_string(if array_objects { "]" } else { "}" })
  #|  out.to_string()
  #|}

///|
async fn main {
  if !@fs.exists("scripts/gen-json-storage-tests.mbtx") {
    fail(
      "run from the repository root: moon run scripts/gen-json-storage-tests.mbtx",
    )
  }
  let out = [
    "// Generated by scripts/gen-json-storage-tests.mbtx from SQL Server captures.",
  ]
  let mut count = 0
  for name in ["json-binary-size", "json-binary-boundaries"] {
    let document = read_json("\{CORPUS}/\{name}.expected.json")
    guard key(document, "cases") is Object(cases) else { fail(name) }
    for case_key, case in cases {
      let step = idx(key(case, "steps"), 0)
      if !arr(key(step, "errors")).is_empty() {
        continue
      }
      guard first_row(step, 0) is [size, canonical] else { fail(case_key) }
      // MoonBit uses Unicode scalar escapes rather than JSON's UTF-16 ones.
      let literal = py_text_literal(canonical)
      out.append([
        "",
        "///|",
        "test \"native JSON construction storage \{name} \{case_key}\" {",
        "  assert_eq(@types.json_constructed_storage_bytes(\{literal}), \{py_text(size)})",
        "}",
      ])
      count += 1
    }
  }
  // Mutation tests consume captured canonical results as input to the allocation
  // tracker; expected text and sizes remain exclusively oracle-derived.
  let modify_pattern = @string.Regex("JSON_MODIFY\\(j,N?'([^']*)',")
  for name in ["json-modify-allocation", "json-allocation-sequences"] {
    let cases = arr(key(read_json("\{CORPUS}/\{name}.cases.json"), "cases"))
    let expected = key(read_json("\{CORPUS}/\{name}.expected.json"), "cases")
    for case in cases {
      let case_name = str(key(case, "name"))
      let step = idx(key(key(expected, case_name), "steps"), 0)
      let sets = arr(key(step, "sets"))
      if sets.length() < 2 {
        continue
      }
      guard first_row(step, 0) is [initial, initial_size, _] else {
        fail(case_name)
      }
      let paths = modify_pattern
        .find(str(key(idx(key(case, "steps"), 0), "sql")))
        .map(m => m.group(1).unwrap().to_owned())
        .to_array()
      guard paths.length() == sets.length() - 1 else { fail(case_name) }
      let label = "native JSON mutation \{name} \{case_name}"
      out.append([
        "",
        "///|",
        "test \{py_str(label)} {",
        "  let original = @types.JsonData::parse(\{py_text_literal(initial)})",
        "  let mut value = original",
        "  let mut previous_size = \{py_text(initial_size)}",
        "  let mutations : Array[(String, String, Int)] = [",
      ])
      for i, path in paths {
        guard first_row(step, i + 1) is [canonical, size, _] else {
          fail(case_name)
        }
        out.push(
          "    (\{py_str(path)}, \{py_text_literal(canonical)}, \{py_text(size)}),",
        )
      }
      out.append([
        "  ]",
        "  for (path, canonical, size) in mutations {",
        "    let previous = value",
        "    value = value.modified(canonical, path)",
        "    assert_eq(value.text(), canonical)",
        "    assert_eq(value.storage_bytes(), size)",
        "    assert_eq(previous.storage_bytes(), previous_size)",
        "    previous_size = size",
        "  }",
        "  assert_eq(original.storage_bytes(), \{py_text(initial_size)})",
        "  assert_eq(original.text(), \{py_text_literal(initial)})",
        "}",
      ])
      count += 1
    }
  }
  // Compact input builders mirror the generated SQL documents. Sizes are read
  // from the oracle, including the delayed dictionary-index transitions.
  out.push(keys_builder)
  let shapes = [
    ("parent-array-", "[", "]"),
    ("parent-object-", "{\"a\":", "}"),
    ("sibling-array-", "[", ",[1,2]]"),
    ("sibling-object-", "{\"a\":", ",\"b\":{\"c\":1,\"d\":2}}"),
  ]
  for
    name in [
      "json-wide-storage", "json-dictionary-index", "json-wide-growth", "json-large-cardinality",
      "json-global-wide-format",
    ] {
    guard key(read_json("\{CORPUS}/\{name}.expected.json"), "cases")
      is Object(cases) else {
      fail(name)
    }
    for case_key, case in cases {
      if case_key.contains("padding") {
        continue
      }
      guard case_key.rev_split_once("-") is Some((_, count_text)) else {
        fail("no element count in \{case_key}")
      }
      let n = @string.parse_int(count_text)
      let array_objects = case_key.has_prefix("array-objects-")
      let initial = if case_key.has_prefix("object-") || array_objects {
        "json_storage_keys(\{n}, array_objects=\{array_objects})"
      } else {
        let flat = "\"[\" + \"0,\".repeat(\{n - 1}) + \"0]\""
        match shapes.search_by(s => case_key.has_prefix(s.0)) {
          Some(i) => {
            let (_, prefix, suffix) = shapes[i]
            "\{py_str(prefix)} + (\{flat}) + \{py_str(suffix)}"
          }
          None => flat
        }
      }
      let sizes = arr(key(idx(key(case, "steps"), 0), "sets")).map(set => {
        py_text(idx(idx(key(set, "rows"), 0), 0))
      })
      let array = case_key.has_prefix("array-")
      out.append([
        "",
        "///|",
        "test \"native JSON wide dictionary \{name} \{case_key}\" {",
        "  let initial = \{initial}",
        "  let original = @types.JsonData::parse(initial)",
        "  assert_eq(original.storage_bytes(), \{sizes[0]})",
      ])
      if sizes.length() > 1 {
        out.append(["  let mut value = original", "  let mut text = initial"])
        for i, size in sizes[1:] {
          let prop = if name == "json-dictionary-index" {
            "new"
          } else {
            "new\{i}"
          }
          let suffix = if array { ",1]" } else { ",\"\{prop}\":1}" }
          let path = if array { "append $" } else { "$.\{prop}" }
          out.append([
            "  text = text.unsafe_substring(start=0, end=text.length()-1) + \{py_str(suffix)}",
            "  value = value.modified(text, \{py_str(path)})",
            "  assert_eq(value.storage_bytes(), \{size})",
          ])
        }
        out.push("  assert_eq(original.storage_bytes(), \{sizes[0]})")
      }
      out.push("}")
      count += 1
    }
  }
  @fs.write_file(
    "src/core/types/json_storage_oracle_test.mbt",
    out.join("\n") + "\n",
  )
  println("Generated \{count} oracle-derived JSON storage tests")
}
