///|
// Generate pure graph-pruning tests from captured SQL Server graph pages.
//
//   moon run scripts/gen-vector-pruning-tests.mbtx
//
// Writes src/core/store/vector_prune_test.mbt; run `moon fmt` afterwards.
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
const CORPUS = "harness/corpus/sql2025"

///|
/// Python `json.dumps(str)` (`ensure_ascii=True`): UTF-16 `\uXXXX` escapes.
fn py_str(s : String) -> String {
  let out = StringBuilder()
  out.write_char('"')
  for unit in s.code_units() {
    match unit.to_int() {
      0x22 => out.write_string("\\\"")
      0x5C => out.write_string("\\\\")
      0x0A => out.write_string("\\n")
      0x0D => out.write_string("\\r")
      0x09 => out.write_string("\\t")
      0x08 => out.write_string("\\b")
      0x0C => out.write_string("\\f")
      u if u < 0x20 || u > 0x7E =>
        out.write_string("\\u" + u.to_string(radix=16).pad_start(4, '0'))
      u => out.write_char(u.unsafe_to_char())
    }
  }
  out.write_char('"')
  out.to_string()
}

///|
/// The text Python prints for a captured integer. Captures are written by
/// JavaScript, so a number is integer-shaped (a Python `int`) exactly when it
/// is integral and below 1e21; larger integer literals keep their source text.
fn int_text(j : Json) -> String raise {
  match j {
    Number(_, repr=Some(t)) if t.iter().all(c => c == '-' || c.is_ascii_digit()) =>
      t
    Number(d, repr=None) if d == d.floor() && d.abs() < 1.0e21 =>
      d.to_int64().to_string()
    _ => fail("expected an integer, got \{j.stringify()}")
  }
}

///|
/// Python `str()` of a decoded JSON scalar, as an f-string prints it
/// (non-integer numbers never reach it here, so they fail).
fn py_text(j : Json) -> String raise {
  match j {
    String(s) => s
    Null => "None"
    True => "True"
    False => "False"
    _ => int_text(j)
  }
}

///|
fn key(j : Json, name : String) -> Json raise {
  guard j is Object(fields) && fields.get(name) is Some(v) else {
    fail("missing key \{name}")
  }
  v
}

///|
fn idx(j : Json, i : Int) -> Json raise {
  guard j is Array(items) && items.get(i) is Some(v) else {
    fail("missing index \{i}")
  }
  v
}

///|
fn arr(j : Json) -> Array[Json] raise {
  guard j is Array(items) else { fail("expected an array") }
  items
}

///|
fn str(j : Json) -> String raise {
  guard j is String(s) else { fail("expected a string") }
  s
}

///|
async fn read_json(path : String) -> Json {
  @json.parse(@fs.read_file(path).text())
}

///|
/// The first capture group of the first match, like `re.search(...)[1]`.
fn search(pattern : String, text : String) -> String raise {
  guard @string.Regex(pattern).execute(text) is Some(m) else {
    fail("no match for \{pattern}")
  }
  m.group(1).unwrap().to_owned()
}

///|
/// A graph page as little-endian int32 keys, like `struct.unpack('<i...')`.
fn int32s(hex : String) -> Array[Int] raise {
  let raw = @hex.decode(hex)
  guard raw.length() % 4 == 0 else { fail("graph page is not int32 aligned") }
  Array::makei(raw.length() / 4, i => {
    let b = (k : Int) => raw[4 * i + k].to_int()
    b(0) | (b(1) << 8) | (b(2) << 16) | (b(3) << 24)
  })
}

///|
async fn main {
  if !@fs.exists("scripts/gen-vector-pruning-tests.mbtx") {
    fail(
      "run from the repository root: moon run scripts/gen-vector-pruning-tests.mbtx",
    )
  }
  let cases = arr(
    key(read_json("\{CORPUS}/vector-pruning.cases.json"), "cases"),
  )
  let expected = key(
    read_json("\{CORPUS}/vector-pruning.expected.json"),
    "cases",
  )
  let lines = [
    "// Generated by scripts/gen-vector-pruning-tests.mbtx from SQL Server graph captures.",
    "",
  ]
  let input_pattern = @string.Regex("\\((-?[0-9]+),'(\\[[^']+\\])'\\)")
  let mut node_count = 0
  for case in cases {
    let name = str(key(case, "name"))
    let steps = arr(key(case, "steps"))
    let metric = search("METRIC='([A-Za-z0-9_]+)'", str(key(steps[1], "sql")))
    let metric_enum = match metric {
      "cosine" => "Cosine"
      "euclidean" => "Euclidean"
      "dot" => "Dot"
      _ => fail("unknown metric \{metric}")
    }
    let setup = str(key(steps[0], "sql"))
    let dimensions = @string.parse_int(search("v vector\\(([0-9]+)\\)", setup))
    let inputs = input_pattern.find(setup).to_array()
    let capture = key(expected, name)
    for step in arr(key(capture, "steps")) {
      guard arr(key(step, "errors")).is_empty() else { fail(name) }
    }
    let rows = arr(
      key(idx(key(idx(key(capture, "steps"), 2), "sets"), 0), "rows"),
    )
    guard rows.length() == inputs.length() else { fail(name) }
    lines.append([
      "///|",
      "test \"vector pruning oracle \{name}\" {",
      "  let vectors : Array[(Int, @types.VectorData)] = [",
    ])
    for m in inputs {
      let input_key = m.group(1).unwrap()
      let text = m.group(2).unwrap().to_owned()
      lines.push(
        "    (\{input_key}, @types.vector_parse(\{py_str(text)}, \{dimensions})),",
      )
    }
    lines.append(["  ]", "  let expected : Array[(Int, Array[Int])] = ["])
    for row in rows {
      let value = idx(row, 1)
      guard key(value, "kind") is String("binary") else { fail(name) }
      let neighbors = int32s(str(key(value, "value")))
      guard neighbors.length() <= 48 else { fail(name) }
      let list = neighbors.map(n => n.to_string()).join(", ")
      lines.push("    (\{py_text(idx(row, 0))}, [\{list}]),")
      node_count += 1
    }
    lines.append([
      "  ]",
      "  for (key, neighbors) in expected {",
      "    let source = vectors[vectors.search_by(v => v.0 == key).unwrap()].1",
      "    let candidates : Array[@store.VectorCandidate] = []",
      "    for (candidate_key, vector) in vectors {",
      "      if candidate_key != key {",
      "        candidates.push({",
      "          key: candidate_key,",
      "          vector,",
      "          distance: source.distance(vector, \"\{metric}\"),",
      "        })",
      "      }",
      "    }",
      "    candidates.sort_by((a, b) => a.distance.compare(b.distance))",
      "    assert_eq(@store.vector_prune(candidates, @store.\{metric_enum}), neighbors)",
      "  }",
      "}",
      "",
    ])
  }
  @fs.write_file("src/core/store/vector_prune_test.mbt", lines.join("\n"))
  println(
    "Generated \{cases.length()} pruning tests checking \{node_count} captured neighbor lists",
  )
}
