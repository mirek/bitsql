///|
// Generates src/core/types/language_data.mbt from the oracle's
// sys.syslanguages and its INFO 5703 texts, captured in
// harness/corpus/settings/language.expected.json (cases 0001-syslanguages and
// 0000-all-languages-5703; generator harness/gen/settings.mjs).
//
// Run from the repo root: moon run scripts/gen-languages.mbtx && moon fmt

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}

///|
let src_path : String = "harness/corpus/settings/language.expected.json"

///|
let out_path : String = "src/core/types/language_data.mbt"

///|
fn get(j : Json, key : String) -> Json raise {
  guard j is Object(m) else { fail("not an object looking up \{key}") }
  guard m.get(key) is Some(v) else { fail("missing key \{key}") }
  v
}

///|
fn items(j : Json) -> Array[Json] raise {
  guard j is Array(a) else { fail("not an array") }
  a
}

///|
fn last(j : Json) -> Json raise {
  guard items(j).last() is Some(v) else { fail("empty array") }
  v
}

///|
fn text(j : Json) -> String raise {
  guard j is String(s) else { fail("not a string") }
  s
}

///|
/// Python's f-string rendering of a JSON integer. Non-integral numbers are
/// refused: the capture holds none, and a parsed Json cannot tell `1.0` (a
/// Python float) from `1`.
fn py_int(j : Json) -> String raise {
  match j {
    Number(_, repr=Some(r)) if r
      .iter()
      .all(c => c == '-' || (c >= '0' && c <= '9')) =>
      if r == "-0" {
        "0"
      } else {
        r
      }
    Number(d, repr=None) if d == d.floor() && d.abs() < 9007199254740992.0 =>
      d.to_int64().to_string()
    _ => fail("not an integer: \{j.stringify()}")
  }
}

///|
/// Python's `str.isspace` (what `str.strip()` removes).
fn is_py_space(c : Char) -> Bool {
  match c {
    ' ' | '\t' | '\n' | '\r' | '\u{0b}' | '\u{0c}' => true
    '\u{1c}'..='\u{1f}' | '\u{85}' | '\u{a0}' | '\u{1680}' => true
    '\u{2000}'..='\u{200a}' | '\u{2028}' | '\u{2029}' | '\u{202f}' => true
    '\u{205f}' | '\u{3000}' => true
    _ => false
  }
}

///|
/// `x.strip().capitalize()` for the ASCII dateformat codes (mdy, dmy, ...);
/// non-ASCII text is refused rather than case-mapped differently.
fn capitalized(x : String) -> String raise {
  let t = x.to_array()
  let mut start = 0
  let mut end = t.length()
  while start < end && is_py_space(t[start]) {
    start += 1
  }
  while end > start && is_py_space(t[end - 1]) {
    end -= 1
  }
  let b = StringBuilder()
  for i in start..<end {
    let c = t[i]
    guard c.to_int() < 0x80 else { fail("non-ASCII dateformat \{x}") }
    let upper = c >= 'a' && c <= 'z'
    let lower = c >= 'A' && c <= 'Z'
    if i == start && upper {
      b.write_char((c.to_int() - 32).unsafe_to_char())
    } else if i != start && lower {
      b.write_char((c.to_int() + 32).unsafe_to_char())
    } else {
      b.write_char(c)
    }
  }
  b.to_string()
}

///|
async fn main {
  if !@fs.exists("scripts/gen-languages.mbtx") {
    fail("run from the repo root: moon run scripts/gen-languages.mbtx")
  }
  let source = @fs.read_file(src_path).text().replace_all(old="\r\n", new="\n")
  let cases = get(@json.parse(source), "cases")
  let rows = items(
    get(
      items(get(last(get(get(cases, "0001-syslanguages"), "steps")), "sets"))[0],
      "rows",
    ),
  )
  let infos = []
  for
    i in items(
      get(last(get(get(cases, "0000-all-languages-5703"), "steps")), "info"),
    ) {
    if get(i, "number") is Number(5703, ..) {
      infos.push(text(get(i, "message")))
    }
  }
  guard rows.length() == 34 && infos.length() == 34 else {
    fail("(\{rows.length()}, \{infos.length()})")
  }
  let out = [
    "// Generated by scripts/gen-languages.mbtx from the oracle's sys.syslanguages",
    "// (harness/corpus/settings/language.expected.json). Do not edit.", "", "///|",
    "/// The 34 languages of sys.syslanguages, by langid: langid|name|alias|", "/// dateformat|datefirst|months|short months|days (comma-separated)|lcid|",
    "/// msglangid|changed message (text: decoded on first use, see languages()).",
    "let language_text : String =",
  ]
  for k, r in rows {
    let r = items(r)
    guard r.length() == 11 else {
      fail("syslanguages row has \{r.length()} columns")
    }
    let langid = r[0]
    let dateformat = r[1]
    let datefirst = r[2]
    let name = r[4]
    let alias_name = r[5]
    let months = r[6]
    let shortmonths = r[7]
    let days = r[8]
    let lcid = r[9]
    let msglangid = r[10]
    let fields = [
      py_int(langid),
      text(name),
      text(alias_name),
      capitalized(text(dateformat)),
      py_int(datefirst),
      text(months),
      text(shortmonths),
      text(days),
      py_int(lcid),
      py_int(msglangid),
      infos[k],
    ]
    for field in fields {
      if field.contains("|") || field.contains("\n") || field.contains("\r") {
        fail("separator or line break in \{field}")
      }
    }
    out.push("  #|" + fields.join("|"))
  }
  @fs.write_file(out_path, out.join("\n") + "\n")
  let root = match @env.current_dir() {
    Some(dir) => dir
    None => "."
  }
  println("wrote \{root}/\{out_path}: \{rows.length()} languages")
}
