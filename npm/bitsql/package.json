{
  "name": "bitsql",
  "version": "0.0.0",
  "description": "Memory-only SQL Server emulator speaking TDS: start it from Node tests instead of the mssql/server container",
  "keywords": ["sql", "tsql", "mssql", "sqlserver", "tds", "tedious", "emulator", "testing", "jest"],
  "homepage": "https://github.com/mirek/bitsql#readme",
  "repository": { "type": "git", "url": "git+https://github.com/mirek/bitsql.git", "directory": "npm/bitsql" },
  "license": "CC0-1.0",
  "author": "Mirek Rusin",
  "type": "commonjs",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": { "bitsql": "bin/bitsql.js" },
  "files": ["index.js", "index.mjs", "index.d.ts", "bin/bitsql.js"],
  "engines": { "node": ">=18" },
  "optionalDependencies": {}
}
