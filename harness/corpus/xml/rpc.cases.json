      "steps": [
        {
          "kind": "rpc",
          "sql": "DECLARE @x xml = @p; SELECT @x AS x, @x.value('(/a/b)[1]', 'int') AS v",
          "params": [{"name":"@p","type":"nvarchar(max)","value":"<a><b>7</b></a>"}]
        }
      ]
    },
    {
      "name": "001-select-cast-p-as-xml-as-x",
      "steps": [{"kind":"rpc","sql":"SELECT CAST(@p AS xml) AS x","params":[{"name":"@p","type":"nvarchar(50)","value":"<a>"}]}]
    },
    {
