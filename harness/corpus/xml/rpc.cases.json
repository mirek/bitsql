    {
      "name": "005-dbo-px",
      "steps": [
        {
          "kind": "batch",
          "sql": "CREATE PROCEDURE dbo.px @d xml, @n int OUTPUT AS BEGIN SET @n = @d.value('count(/r/i)', 'int'); SELECT @d AS d; END",
          "compare": false
        },
        {
          "kind": "proc",
          "sql": "dbo.px",
          "params": [{"name":"@d","type":"nvarchar(max)","value":"<r><i/><i/></r>"},{"name":"@n","type":"int","output":true}]
        }
      ]
