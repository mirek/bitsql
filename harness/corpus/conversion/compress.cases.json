    {
      "name": "000-declare-s-varchar-max-i-bigint-1-while-i-3000-begi",
      "steps": [
        {
          "kind": "batch",
          "sql": "DECLARE @s varchar(max) = '', @i bigint = 1; WHILE @i <= 3000 BEGIN SET @s = @s + CHAR(97 + ((@i * 2654435761) % 4294967296) / 65536 % 3); SET @i = @i + 1 END; SELECT COMPRESS(@s) AS v"
        }
      ]
    },
