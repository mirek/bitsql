      #|[1260,"[0.792114,-0.510547,-0.711497]",[-195,-168,-117,-30,57,225,669,990,1038,1041]],
      #|[1263,"[-0.24192,0.006102,0.355313]",[123,180,327,372,444,573,747,783]],
      #|[1266,"[0.501152,0.977758,-0.320796]",[-156,-123,501,588]],
      #|[1269,"[0.772811,0.426373,-0.773409]",[-195,-78,-63,-48,87,300,675,927]],
      #|[1272,"[-0.292977,-0.825101,0.217027]",[-72,-51,111,195,213,456,729,909]],
      #|[1275,"[0.081376,-0.870137,0.302187]",[42,456,729,867,909]],
      #|[1278,"[0.699862,-0.974951,-0.36415]",[309,453,750,1122,1176]],
      #|[1281,"[-0.822085,0.390041,0.705463]",[-93,180,354,426,513,612,648,837,1008,1233]],
      #|[1284,"[0.045139,0.409161,0.810159]",[408,471,579,612,762,888]],
      #|[1287,"[0.802379,0.64342,0.904224]",[135,315,471,777,873,939]],
      #|[1290,"[-0.153551,0.456499,-0.398348]",[-159,-141,-132,129,273,861,945,963,1104]],
      #|[1293,"[-0.343586,-0.647679,0.383983]",[-201,-51,111,195,720,747,831,909,1143]],
      #|[1296,"[0.837348,0.590389,-0.69467]",[-156,-48,-39,-12,87,105,453,882,927,957]]
      #|]
    ),
    3,
    @types.Float32,
  )
  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Euclidean), Some(1251))
  let graph = @store.vector_build(input, 1251, @store.Euclidean, alignment=30)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse("[-0.659664,0.941758,-0.041042]", 3),
    @store.Euclidean,
    10,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[525,0.1737261265516281],
      #|[717,0.1910247951745987],
      #|[576,0.24122516810894012],
      #|[1191,0.25772327184677124],
      #|[258,0.30719831585884094],
      #|[1023,0.3291010558605194],
      #|[1224,0.33120056986808777],
      #|[390,0.33211764693260193],
      #|[1230,0.33296844363212585],
      #|[351,0.3435248136520386]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
