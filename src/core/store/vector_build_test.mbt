      #|[1263,"[-0.24192,0.006102,0.355313]",[-84,81,102,372,483,507]],
      #|[1266,"[0.501152,0.977758,-0.320796]",[-156,-141,-114,75,501,528]],
      #|[1269,"[0.772811,0.426373,-0.773409]",[-78,-48,-30,-12,174]],
      #|[1272,"[-0.292977,-0.825101,0.217027]",[-72,-51,33,432,456,459]],
      #|[1275,"[0.081376,-0.870137,0.302187]",[-111,-3,42,381,558]],
      #|[1278,"[0.699862,-0.974951,-0.36415]",[24,57,150,288,381]],
      #|[1281,"[-0.822085,0.390041,0.705463]",[-93,-21,18,354,513]],
      #|[1284,"[0.045139,0.409161,0.810159]",[18,243,354,408,534]],
      #|[1287,"[0.802379,0.64342,0.904224]",[75,243,297,336,408]],
      #|[1290,"[-0.153551,0.456499,-0.398348]",[-150,129,273,279,345,546]],
      #|[1293,"[-0.343586,-0.647679,0.383983]",[-123,111,147,165,177,456,558]],
      #|[1296,"[0.837348,0.590389,-0.69467]",[-63,-48,-12,75,174,348]]
      #|]
    ),
    3,
    @types.Float32,
  )
  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Cosine), Some(1074))
  let graph = @store.vector_build(input, 1074, @store.Cosine, alignment=480)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse("[-0.659664,0.941758,-0.041042]", 3),
    @store.Cosine,
    10,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[1191,0.00027447938919067383],
      #|[717,0.0008296370506286621],
      #|[525,0.004756033420562744],
      #|[1230,0.005917608737945557],
      #|[1137,0.009281396865844727],
      #|[1023,0.011679351329803467],
      #|[576,0.021638870239257812],
      #|[351,0.02192974090576172],
      #|[960,0.03046804666519165],
      #|[390,0.03212440013885498]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
