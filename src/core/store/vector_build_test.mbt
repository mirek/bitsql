    3,
    @types.Float32,
  )
  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Dot), Some(-147))
  let graph = @store.vector_build(input, -147, @store.Dot, alignment=120)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse("[-0.659664,0.941758,-0.041042]", 3),
    @store.Dot,
    10,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[141,-1.5426161289215088],
      #|[885,-1.5417397022247314],
      #|[537,-1.4763143062591553],
      #|[525,-1.4631807804107666],
      #|[201,-1.4072703123092651],
      #|[258,-1.3358763456344604],
      #|[291,-1.3348246812820435],
      #|[657,-1.3321723937988281],
      #|[996,-1.316964864730835],
      #|[-165,-1.3009660243988037]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
