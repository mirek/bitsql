///|
test "vector build oracle euclidean-3-20" {
  let (input, expected) = vector_build_fixture(
    (
      #|[
      #|[-201,"[0.468521,0.051414,-0.6376]",[-195,-177,-171,-165,-159,-153]],
      #|[-198,"[-0.849386,-0.811088,-0.546407]",[-189]],
      #|[-195,"[0.61581,0.025521,-0.922825]",[-201,-186,-177,-171,-153]],
      #|[-192,"[-0.329993,0.750275,-0.911257]",[-189,-165,-150,-147]],
      #|[-189,"[-0.055645,-0.038383,-0.346213]",[-198,-192,-168,-165,-156,-153]],
      #|[-186,"[0.148335,0.582588,0.890412]",[-162,-159,-156]],
      #|[-183,"[0.337499,-0.628153,0.510882]",[-180,-174,-171,-168,-162,-159]],
      #|[-180,"[0.965791,-0.156755,0.622346]",[-183,-171,-159]],
      #|[-177,"[0.36492,0.820259,-0.791038]",[-195,-192,-165,-150]],
      #|[-174,"[0.480069,-0.843608,-0.275969]",[-198,-171,-162,-153]],
      #|[-171,"[0.945034,-0.739188,0.243611]",[-183,-180,-177,-174,-144]],
      #|[-168,"[0.00038,-0.142941,0.147772]",[-198,-189,-174,-162,-159,-156]],
      #|[-165,"[0.17486,0.312009,-0.371341]",[-201,-189,-177,-159,-156]],
      #|[-162,"[-0.022843,-0.702158,0.336151]",[-198,-183,-174,-168]],
      #|[-159,"[0.684167,0.287063,0.327627]",[-201,-186,-180,-177,-168]],
      #|[-156,"[-0.520606,0.644702,0.37986]",[-192,-186,-168,-150,-147]],
      #|[-153,"[0.274935,-0.394047,-0.818098]",[-201,-198,-189,-174]],
      #|[-150,"[0.195453,0.959588,-0.694495]",[-192,-186,-177,-165,-147]],
      #|[-147,"[-0.931062,0.653243,0.198909]",[-198,-192,-189,-156]],
      #|[-144,"[0.963197,-0.887291,0.770575]",[-183,-180,-171]]
      #|]
    ),
    3,
    @types.Float32,
  )
  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Euclidean), Some(-168))
  let graph = @store.vector_build(input, -168, @store.Euclidean, alignment=480)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse("[0.235511,-0.695661,-0.486699]", 3),
    @store.Euclidean,
    10,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[-174,0.35511133074760437],
      #|[-153,0.4498339593410492],
      #|[-189,0.7324769496917725],
      #|[-201,0.7969854474067688],
      #|[-162,0.8624796271324158],
      #|[-168,0.8736929893493652],
      #|[-195,0.9246278405189514],
      #|[-183,1.0050506591796875],
      #|[-165,1.0160634517669678],
      #|[-171,1.0191516876220703]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
  let result = graph.search(
    @types.vector_parse("[0.235511,-0.695661,-0.486699]", 3),
    @store.Euclidean,
    1000,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[-174,0.35511133074760437],
      #|[-153,0.4498339593410492],
      #|[-189,0.7324769496917725],
      #|[-201,0.7969854474067688],
      #|[-162,0.8624796271324158],
      #|[-168,0.8736929893493652],
      #|[-195,0.9246278405189514],
      #|[-183,1.0050506591796875],
      #|[-165,1.0160634517669678],
      #|[-171,1.0191516876220703],
      #|[-198,1.0926527976989746],
      #|[-159,1.3528361320495605],
      #|[-180,1.4330768585205078],
      #|[-144,1.4652599096298218],
      #|[-177,1.5515739917755127],
      #|[-192,1.6095885038375854],
      #|[-150,1.6687220335006714],
      #|[-156,1.766128659248352],
      #|[-186,1.8809452056884766],
      #|[-147,1.9106264114379883]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
}

