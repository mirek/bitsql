///|
test "vector build oracle cosine-d3-n20-dop1-half" {
  let (input, expected) = vector_build_fixture(
    (
      #|[
      #|[-144,"[0.697434,0.184982,-0.488938]",[-186,-174,-156,-153,-147]],
      #|[-147,"[-0.461855,-0.555263,-0.371165]",[-195,-171,-168,-162,-156]],
      #|[-150,"[0.993311,-0.791839,-0.131984]",[-183,-171,-159,-156]],
      #|[-153,"[0.47546,0.857585,-0.856009]",[-201,-192,-147,-144]],
      #|[-156,"[0.807772,-0.530169,-0.828789]",[-150,-147,-144]],
      #|[-159,"[0.843702,-0.211457,0.177825]",[-186,-183,-177,-150]],
      #|[-162,"[-0.798606,-0.038635,-0.854406]",[-198,-195,-180,-156]],
      #|[-165,"[-0.596157,-0.741128,0.406941]",[-174,-171,-168]],
      #|[-168,"[-0.638711,-0.470803,0.139396]",[-195,-189,-186,-183,-165]],
      #|[-171,"[0.269187,-0.990171,0.829274]",[-177,-165,-150]],
      #|[-174,"[-0.247153,0.213703,0.773236]",[-201,-198,-189,-165,-144]],
      #|[-177,"[0.22664,-0.39267,0.814903]",[-201,-189,-171,-159]],
      #|[-180,"[-0.213872,0.549797,-0.631332]",[-198,-192,-162,-144]],
      #|[-183,"[-0.351884,0.954041,-0.031655]",[-201,-198,-192]],
      #|[-186,"[0.842202,-0.117571,-0.167172]",[-198,-159,-156,-150,-144]],
      #|[-189,"[-0.834037,-0.431626,0.346648]",[-198,-177,-174,-171,-168,-162]],
      #|[-192,"[-0.174941,0.959122,-0.70382]",[-183,-180,-168,-153]],
      #|[-195,"[-0.476094,-0.459914,-0.321408]",[-168,-162,-156,-147]],
      #|[-198,"[-0.925239,0.586512,0.182297]",[-189,-183,-174,-162]],
      #|[-201,"[0.090644,0.12048,0.731006]",[-177,-174,-153,-144]]
      #|]
    ),
    3,
    @types.Float16,
  )
  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Cosine), Some(-201))
  let graph = @store.vector_build(input, -201, @store.Cosine, alignment=30)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse("[0.66671,0.043098,-0.597462]", 3, base=@types.Float16),
    @store.Cosine,
    10,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[-144,0.020648539066314697],
      #|[-156,0.1140516996383667],
      #|[-186,0.15525227785110474],
      #|[-153,0.25814151763916016],
      #|[-150,0.3826075792312622],
      #|[-159,0.43830597400665283],
      #|[-180,0.666236937046051],
      #|[-192,0.6795779466629028],
      #|[-162,1.0223023891448975],
      #|[-147,1.151159644126892]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
  let result = graph.search(
    @types.vector_parse("[0.66671,0.043098,-0.597462]", 3, base=@types.Float16),
    @store.Cosine,
    1000,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[-144,0.020648539066314697],
      #|[-156,0.1140516996383667],
      #|[-186,0.15525227785110474],
      #|[-153,0.25814151763916016],
      #|[-150,0.3826075792312622],
      #|[-159,0.43830597400665283],
      #|[-180,0.666236937046051],
      #|[-192,0.6795779466629028],
      #|[-162,1.0223023891448975],
      #|[-147,1.151159644126892],
      #|[-183,1.1913200616836548],
      #|[-195,1.2200267314910889],
      #|[-171,1.3033690452575684],
      #|[-177,1.4222140312194824],
      #|[-201,1.5550159215927124],
      #|[-198,1.703657627105713],
      #|[-165,1.7252652645111084],
      #|[-168,1.7330975532531738],
      #|[-174,1.8209514617919922],
      #|[-189,1.8712414503097534]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
}

