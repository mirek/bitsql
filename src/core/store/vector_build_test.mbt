  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Cosine), Some(36))
  let graph = @store.vector_build(input, 36, @store.Cosine, alignment=690)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse(
      "[0.627526,-0.171649,0.236079,0.435857,0.234644,-0.710486,0.446803,0.33428]",
      8,
    ),
    @store.Cosine,
    10,
  )
