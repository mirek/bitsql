  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Euclidean), Some(1251))
  let graph = @store.vector_build(input, 1251, @store.Euclidean, alignment=120)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse("[-0.659664,0.941758,-0.041042]", 3),
    @store.Euclidean,
    10,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[525,0.1737261265516281],
      #|[717,0.1910247951745987],
      #|[576,0.24122516810894012],
      #|[1191,0.25772327184677124],
      #|[258,0.30719831585884094],
      #|[1023,0.3291010558605194],
      #|[1224,0.33120056986808777],
      #|[390,0.33211764693260193],
      #|[1230,0.33296844363212585],
      #|[351,0.3435248136520386]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
