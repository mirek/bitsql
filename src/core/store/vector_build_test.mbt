// Generated by scripts/gen-vector-build-tests.py from oracle graph captures.

///|
fn vector_build_array(value : Json) -> Array[Json] raise {
  match value {
    Array(values) => values
    _ => fail("Expected an array in the oracle fixture")
  }
}

///|
fn vector_build_number(value : Json) -> Double raise {
  match value {
    Number(number, ..) => number
    _ => fail("Expected a number in the oracle fixture")
  }
}

///|
fn vector_build_string(value : Json) -> String raise {
  match value {
    String(text) => text
    _ => fail("Expected a string in the oracle fixture")
  }
}

///|
fn vector_build_fixture(
  text : String,
  dimensions : Int,
  base : @types.VectorBase,
) -> (Array[(Int, @types.VectorData)], Array[(Int, Array[Int])]) raise {
  let input = []
  let expected = []
  for entry in vector_build_array(@json.parse(text)) {
    let fields = vector_build_array(entry)
    let key = vector_build_number(fields[0]).to_int()
    input.push(
      (
        key,
        @types.vector_parse(vector_build_string(fields[1]), dimensions, base~),
      ),
    )
    expected.push(
      (
        key,
        vector_build_array(fields[2]).map(e => vector_build_number(e).to_int()),
      ),
    )
  }
  expected.sort_by((a, b) => a.0.compare(b.0))
  (input, expected)
}

///|
fn vector_search_fixture(text : String) -> Array[(Int, Double)] raise {
  vector_build_array(@json.parse(text)).map(entry => {
    let fields = vector_build_array(entry)
    (vector_build_number(fields[0]).to_int(), vector_build_number(fields[1]))
  })
}

///|
test "vector build oracle cosine-3-20" {
  let (input, expected) = vector_build_fixture(
    (
      #|[
      #|[-201,"[0.468521,0.051414,-0.6376]",[-195,-189,-174,-171,-165]],
      #|[-198,"[-0.849386,-0.811088,-0.546407]",[-189,-162,-147]],
      #|[-195,"[0.61581,0.025521,-0.922825]",[-201,-192,-171,-165,-153]],
      #|[-192,"[-0.329993,0.750275,-0.911257]",[-189,-150,-147]],
      #|[-189,"[-0.055645,-0.038383,-0.346213]",[-198,-192,-153]],
      #|[-186,"[0.148335,0.582588,0.890412]",[-168,-159,-156]],
      #|[-183,"[0.337499,-0.628153,0.510882]",[-186,-174,-168,-144]],
      #|[-180,"[0.965791,-0.156755,0.622346]",[-201,-159,-147,-144]],
      #|[-177,"[0.36492,0.820259,-0.791038]",[-189,-165,-159,-150]],
      #|[-174,"[0.480069,-0.843608,-0.275969]",[-198,-171,-162,-153]],
      #|[-171,"[0.945034,-0.739188,0.243611]",[-174,-159,-144]],
      #|[-168,"[0.00038,-0.142941,0.147772]",[-186,-183,-162]],
      #|[-165,"[0.17486,0.312009,-0.371341]",[-201,-192,-177,-159]],
      #|[-162,"[-0.022843,-0.702158,0.336151]",[-198,-174,-168,-144]],
      #|[-159,"[0.684167,0.287063,0.327627]",[-186,-180,-177]],
      #|[-156,"[-0.520606,0.644702,0.37986]",[-186,-150,-147]],
      #|[-153,"[0.274935,-0.394047,-0.818098]",[-195,-189,-186,-174]],
      #|[-150,"[0.195453,0.959588,-0.694495]",[-192,-186,-177,-159,-156]],
      #|[-147,"[-0.931062,0.653243,0.198909]",[-198,-192,-162,-156]],
      #|[-144,"[0.963197,-0.887291,0.770575]",[-183,-180,-171,-156]]
      #|]
    ),
    3,
    @types.Float32,
  )
  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Cosine), Some(-201))
  let graph = @store.vector_build(input, -201, @store.Cosine, alignment=480)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse("[0.235511,-0.695661,-0.486699]", 3),
    @store.Cosine,
    10,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[-174,0.06169790029525757],
      #|[-153,0.11829328536987305],
      #|[-195,0.41046416759490967],
      #|[-189,0.41409575939178467],
      #|[-171,0.4268624186515808],
      #|[-198,0.44786596298217773],
      #|[-201,0.449049174785614],
      #|[-162,0.5344127416610718],
      #|[-144,0.6496340036392212],
      #|[-183,0.6534756422042847]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
  let result = graph.search(
    @types.vector_parse("[0.235511,-0.695661,-0.486699]", 3),
    @store.Cosine,
    1000,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[-174,0.06169790029525757],
      #|[-153,0.11829328536987305],
      #|[-195,0.41046416759490967],
      #|[-189,0.41409575939178467],
      #|[-171,0.4268624186515808],
      #|[-198,0.44786596298217773],
      #|[-201,0.449049174785614],
      #|[-162,0.5344127416610718],
      #|[-144,0.6496340036392212],
      #|[-183,0.6534756422042847],
      #|[-168,0.8475925922393799],
      #|[-180,0.9671054482460022],
      #|[-165,0.9893007278442383],
      #|[-177,1.0945531129837036],
      #|[-192,1.1445962190628052],
      #|[-150,1.268021821975708],
      #|[-159,1.2771109342575073],
      #|[-147,1.7574094533920288],
      #|[-186,1.8490641117095947],
      #|[-156,1.9412569999694824]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
}

