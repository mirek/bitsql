      #|[201,-1.4072703123092651],
      #|[258,-1.3358763456344604],
      #|[291,-1.3348246812820435],
      #|[657,-1.3321723937988281],
      #|[996,-1.316964864730835],
      #|[-165,-1.3009660243988037]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
