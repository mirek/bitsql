///|
test "vector build oracle euclidean-d3-n20-dop1-half" {
  let (input, expected) = vector_build_fixture(
    (
      #|[
      #|[-144,"[0.697434,0.184982,-0.488938]",[-201,-195,-186,-183,-156,-153]],
      #|[-147,"[-0.461855,-0.555263,-0.371165]",[-195,-183,-171,-168,-162,-156]],
      #|[-150,"[0.993311,-0.791839,-0.131984]",[-171,-159,-156,-147]],
      #|[-153,"[0.47546,0.857585,-0.856009]",[-192,-189,-144]],
      #|[-156,"[0.807772,-0.530169,-0.828789]",[-186,-150,-147,-144]],
      #|[-159,"[0.843702,-0.211457,0.177825]",[-195,-186,-183,-177,-150]],
      #|[-162,"[-0.798606,-0.038635,-0.854406]",[-198,-195,-180]],
      #|[-165,"[-0.596157,-0.741128,0.406941]",[-177,-168,-156]],
      #|[-168,"[-0.638711,-0.470803,0.139396]",[-201,-198,-195,-189,-174,-165,-144]],
      #|[-171,"[0.269187,-0.990171,0.829274]",[-177,-165,-150]],
      #|[-174,"[-0.247153,0.213703,0.773236]",[-201,-198,-189,-171,-144]],
      #|[-177,"[0.22664,-0.39267,0.814903]",[-201,-171,-165,-159]],
      #|[-180,"[-0.213872,0.549797,-0.631332]",[-201,-198,-192,-183,-162,-153,-144]],
      #|[-183,"[-0.351884,0.954041,-0.031655]",[-201,-198,-192,-174,-162,-144]],
      #|[-186,"[0.842202,-0.117571,-0.167172]",[-195,-174,-159,-156,-150,-144]],
      #|[-189,"[-0.834037,-0.431626,0.346648]",[-198,-174,-168,-165,-162,-144]],
      #|[-192,"[-0.174941,0.959122,-0.70382]",[-183,-180,-159,-153]],
      #|[-195,"[-0.476094,-0.459914,-0.321408]",[-201,-198,-168,-162,-147,-144]],
      #|[-198,"[-0.925239,0.586512,0.182297]",[-189,-183,-174,-162]],
      #|[-201,"[0.090644,0.12048,0.731006]",[-183,-177,-174,-168,-159,-144]]
      #|]
    ),
    3,
    @types.Float16,
  )
  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Euclidean), Some(-201))
  let graph = @store.vector_build(input, -201, @store.Euclidean, alignment=30)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse("[0.66671,0.043098,-0.597462]", 3, base=@types.Float16),
    @store.Euclidean,
    10,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[-144,0.18130001425743103],
      #|[-186,0.492008239030838],
      #|[-156,0.6340352296829224],
      #|[-159,0.8352333903312683],
      #|[-153,0.8754411935806274],
      #|[-150,1.01041841506958],
      #|[-180,1.0163401365280151],
      #|[-192,1.2482361793518066],
      #|[-195,1.278641700744629],
      #|[-147,1.2971432209014893]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
  let result = graph.search(
    @types.vector_parse("[0.66671,0.043098,-0.597462]", 3, base=@types.Float16),
    @store.Euclidean,
    1000,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[-144,0.18130001425743103],
      #|[-186,0.492008239030838],
      #|[-156,0.6340352296829224],
      #|[-159,0.8352333903312683],
      #|[-153,0.8754411935806274],
      #|[-150,1.01041841506958],
      #|[-180,1.0163401365280151],
      #|[-192,1.2482361793518066],
      #|[-195,1.278641700744629],
      #|[-147,1.2971432209014893],
      #|[-201,1.4501121044158936],
      #|[-183,1.4789400100708008],
      #|[-162,1.4899133443832397],
      #|[-177,1.5422972440719604],
      #|[-168,1.5845271348953247],
      #|[-174,1.6564606428146362],
      #|[-165,1.7941091060638428],
      #|[-171,1.8058737516403198],
      #|[-189,1.8353761434555054],
      #|[-198,1.8539917469024658]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
}

