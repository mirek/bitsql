      #|[14796,"[-0.237747,-0.224801,0.77753,0.668088,-0.833826,0.130124,-0.552914,-0.616313]",[525,939,1968,2232,2430,2490,2874,3048,3600,4224,4872,6591,6957,7617,7881,7935,8571,8886,9828,11274,12813,13815]]
      #|]
    ),
    8,
    @types.Float32,
  )
  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Euclidean), Some(6981))
  let graph = @store.vector_build(input, 6981, @store.Euclidean, alignment=30)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse(
      "[0.861438,-0.772053,0.415731,0.964429,0.180342,0.071802,-0.42891,-0.201155]",
      8,
    ),
    @store.Euclidean,
    10,
  )
