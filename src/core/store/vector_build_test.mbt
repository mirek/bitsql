  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Cosine), Some(396))
  let graph = @store.vector_build(input, 396, @store.Cosine, alignment=480)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse(
      "[0.5447,0.342839,0.494986,0.419944,0.311381,-0.916826,-0.595848,-0.407733,-0.928724,0.634573,-0.466378,-0.306339,-0.79905,0.639592,-0.012517,0.109494]",
      16,
    ),
    @store.Cosine,
    10,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[-72,0.3989105820655823],
      #|[279,0.4057154059410095],
