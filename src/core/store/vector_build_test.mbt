      #|[576,0.021638870239257812],
      #|[351,0.02192974090576172],
      #|[960,0.03046804666519165],
      #|[390,0.03212440013885498]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
