///|
test "vector build oracle dot-3-20" {
  let (input, expected) = vector_build_fixture(
    (
      #|[
      #|[-201,"[0.468521,0.051414,-0.6376]",[-195,-192,-183,-177,-174,-171,-168,-165,-162,-150,-144]],
      #|[-198,"[-0.849386,-0.811088,-0.546407]",[-201,-195,-192,-183,-174,-171,-168,-162,-153,-147]],
      #|[-195,"[0.61581,0.025521,-0.922825]",[-198,-192,-180,-177,-174,-171,-165,-162,-150,-144]],
      #|[-192,"[-0.329993,0.750275,-0.911257]",[-201,-198,-195,-177,-165,-159,-150]],
      #|[-189,"[-0.055645,-0.038383,-0.346213]",[-201,-195,-192,-177,-174,-171,-168,-165,-153,-150]],
      #|[-186,"[0.148335,0.582588,0.890412]",[-183,-180,-177,-171,-162,-159,-156,-150,-147,-144]],
      #|[-183,"[0.337499,-0.628153,0.510882]",[-198,-186,-180,-171,-159,-144]],
      #|[-180,"[0.965791,-0.156755,0.622346]",[-201,-195,-183,-177,-174,-171,-162,-156,-150,-144]],
      #|[-177,"[0.36492,0.820259,-0.791038]",[-192,-180,-174,-171,-165,-156,-150,-147]],
      #|[-174,"[0.480069,-0.843608,-0.275969]",[-198,-189,-183,-171,-168,-165,-162,-159,-144]],
      #|[-171,"[0.945034,-0.739188,0.243611]",[-198,-189,-186,-180,-159,-153,-144]],
      #|[-168,"[0.00038,-0.142941,0.147772]",[-201,-198,-192,-189,-186,-183,-180,-174,-171,-162,-159,-156,-144]],
      #|[-165,"[0.17486,0.312009,-0.371341]",[-201,-195,-192,-189,-180,-177,-159,-156,-153,-150,-147]],
      #|[-162,"[-0.022843,-0.702158,0.336151]",[-198,-189,-183,-180,-174,-171,-153,-144]],
      #|[-159,"[0.684167,0.287063,0.327627]",[-183,-180,-177,-174,-171,-168,-165,-162,-150,-144]],
      #|[-156,"[-0.520606,0.644702,0.37986]",[-192,-183,-177,-168,-165,-159,-150,-147]],
      #|[-153,"[0.274935,-0.394047,-0.818098]",[-201,-198,-195,-177,-168,-165,-162,-150,-144]],
      #|[-150,"[0.195453,0.959588,-0.694495]",[-201,-195,-192,-189,-186,-177,-153]],
      #|[-147,"[-0.931062,0.653243,0.198909]",[-198,-189,-186,-177,-165,-156,-153]],
      #|[-144,"[0.963197,-0.887291,0.770575]",[-201,-195,-186,-174,-171,-153]]
      #|]
    ),
    3,
    @types.Float32,
  )
  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Dot), Some(-195))
  let graph = @store.vector_build(input, -195, @store.Dot, alignment=480)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse("[0.235511,-0.695661,-0.486699]", 3),
    @store.Dot,
    10,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[-174,-0.8342405557632446],
      #|[-153,-0.7370408177375793],
      #|[-198,-0.6301382780075073],
      #|[-171,-0.6182249784469604],
      #|[-195,-0.5764140486717224],
      #|[-144,-0.4690592288970947],
      #|[-201,-0.38489440083503723],
      #|[-162,-0.3194798231124878],
      #|[-183,-0.2678205072879791],
      #|[-189,-0.18209807574748993]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
  let result = graph.search(
    @types.vector_parse("[0.235511,-0.695661,-0.486699]", 3),
    @store.Dot,
    1000,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[-174,-0.8342405557632446],
      #|[-153,-0.7370408177375793],
      #|[-198,-0.6301382780075073],
      #|[-171,-0.6182249784469604],
      #|[-195,-0.5764140486717224],
      #|[-144,-0.4690592288970947],
      #|[-201,-0.38489440083503723],
      #|[-162,-0.3194798231124878],
      #|[-183,-0.2678205072879791],
      #|[-189,-0.18209807574748993],
      #|[-180,-0.033607594668865204],
      #|[-168,-0.027607493102550507],
      #|[-165,-0.004860237240791321],
      #|[-177,0.09968215227127075],
      #|[-192,0.15614616870880127],
      #|[-159,0.1980254054069519],
      #|[-150,0.2835066020488739],
      #|[-156,0.7559800148010254],
      #|[-147,0.7705198526382446],
      #|[-186,0.8037118911743164]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
}

