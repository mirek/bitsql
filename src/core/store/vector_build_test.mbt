      #|[1266,"[0.501152,0.977758,-0.320796]",[-156,-123,312,381,501]],
      #|[1269,"[0.772811,0.426373,-0.773409]",[-195,-78,-48,-12,-9,87,174,300,360]],
      #|[1272,"[-0.292977,-0.825101,0.217027]",[-87,-72,-51,111,195,213,288,456]],
      #|[1275,"[0.081376,-0.870137,0.302187]",[-87,24,33,375,402,456]],
      #|[1278,"[0.699862,-0.974951,-0.36415]",[-60,15,57,309]],
      #|[1281,"[-0.822085,0.390041,0.705463]",[-186,-93,-84,-21,180,354,525]],
      #|[1284,"[0.045139,0.409161,0.810159]",[-186,-36,81,180,408,471]],
      #|[1287,"[0.802379,0.64342,0.904224]",[36,135,297,315,471]],
      #|[1290,"[-0.153551,0.456499,-0.398348]",[-159,-141,-132,-114,129,216,273,321,327,501]],
      #|[1293,"[-0.343586,-0.647679,0.383983]",[-201,-111,-51,111,195,324,372,456,552]],
      #|[1296,"[0.837348,0.590389,-0.69467]",[-147,-138,-63,-48,-39,-12,87,105,174]]
      #|]
    ),
    3,
    @types.Float32,
  )
  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Euclidean), Some(1251))
  let graph = @store.vector_build(input, 1251, @store.Euclidean, alignment=480)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse("[-0.659664,0.941758,-0.041042]", 3),
    @store.Euclidean,
    10,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[525,0.1737261265516281],
      #|[717,0.1910247951745987],
      #|[1137,0.22535568475723267],
      #|[576,0.24122516810894012],
      #|[1191,0.25772327184677124],
      #|[258,0.30719831585884094],
      #|[627,0.3155715763568878],
      #|[1023,0.3291010558605194],
      #|[1224,0.33120056986808777],
      #|[390,0.33211764693260193]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
