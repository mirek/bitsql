  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Cosine), Some(2328))
  let graph = @store.vector_build(input, 2328, @store.Cosine, alignment=480)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse(
      "[0.861438,-0.772053,0.415731,0.964429,0.180342,0.071802,-0.42891,-0.201155]",
      8,
    ),
    @store.Cosine,
    10,
  )
