  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Cosine), Some(1074))
  let graph = @store.vector_build(input, 1074, @store.Cosine, alignment=480)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse("[-0.659664,0.941758,-0.041042]", 3),
    @store.Cosine,
    10,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[1191,0.00027447938919067383],
      #|[717,0.0008296370506286621],
      #|[525,0.004756033420562744],
