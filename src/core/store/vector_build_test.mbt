///|
test "vector build oracle dot-d3-n20-dop1-half" {
  let (input, expected) = vector_build_fixture(
    (
      #|[
      #|[-144,"[0.697434,0.184982,-0.488938]",[-192,-183,-180,-177,-171,-162,-153,-150]],
      #|[-147,"[-0.461855,-0.555263,-0.371165]",[-198,-195,-180,-177,-162,-159,-150]],
      #|[-150,"[0.993311,-0.791839,-0.131984]",[-201,-195,-189,-186,-177,-165,-156,-153,-147,-144]],
      #|[-153,"[0.47546,0.857585,-0.856009]",[-198,-192,-186,-183,-180,-162,-159,-150]],
      #|[-156,"[0.807772,-0.530169,-0.828789]",[-195,-192,-186,-180,-171,-162,-159,-150]],
      #|[-159,"[0.843702,-0.211457,0.177825]",[-201,-189,-186,-174,-156,-153,-150,-144]],
      #|[-162,"[-0.798606,-0.038635,-0.854406]",[-195,-192,-189,-183,-171,-168,-165,-156,-153,-147]],
      #|[-165,"[-0.596157,-0.741128,0.406941]",[-198,-195,-189,-174,-168,-162,-156,-150,-147]],
      #|[-168,"[-0.638711,-0.470803,0.139396]",[-201,-195,-189,-180,-177,-174,-165,-147]],
      #|[-171,"[0.269187,-0.990171,0.829274]",[-201,-195,-177,-174,-156,-147]],
      #|[-174,"[-0.247153,0.213703,0.773236]",[-201,-192,-180,-177,-171,-168,-162,-159]],
      #|[-177,"[0.22664,-0.39267,0.814903]",[-201,-198,-189,-186,-171,-168,-165,-159,-156,-150,-147]],
      #|[-180,"[-0.213872,0.549797,-0.631332]",[-198,-195,-192,-186,-183,-168,-156,-153,-147,-144]],
      #|[-183,"[-0.351884,0.954041,-0.031655]",[-201,-192,-189,-180,-174,-165,-162,-153,-144]],
      #|[-186,"[0.842202,-0.117571,-0.167172]",[-201,-183,-180,-177,-174,-162,-159,-156,-153,-150]],
      #|[-189,"[-0.834037,-0.431626,0.346648]",[-201,-195,-183,-168,-165,-147]],
      #|[-192,"[-0.174941,0.959122,-0.70382]",[-198,-195,-189,-186,-180,-168,-156,-153,-147,-144]],
      #|[-195,"[-0.476094,-0.459914,-0.321408]",[-192,-183,-177,-174,-171,-168,-162,-150,-147]],
      #|[-198,"[-0.925239,0.586512,0.182297]",[-192,-189,-183,-180,-177,-171,-168,-165,-153]],
      #|[-201,"[0.090644,0.12048,0.731006]",[-198,-189,-186,-183,-177,-174,-171,-168,-165,-159]]
      #|]
    ),
    3,
    @types.Float16,
  )
  let sample = input.copy()
  sample.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(sample, @store.Dot), Some(-201))
  let graph = @store.vector_build(input, -201, @store.Dot, alignment=30)
  let nodes = graph.nodes()
  assert_eq(nodes.length(), expected.length())
  let bad = []
  for i, node in nodes {
    assert_eq(node.key, expected[i].0)
    let neighbors = node.neighbors.copy()
    neighbors.sort()
    if neighbors != expected[i].1 {
      bad.push(node.key)
    }
  }
  assert_eq(bad, [])
  let result = graph.search(
    @types.vector_parse("[0.66671,0.043098,-0.597462]", 3, base=@types.Float16),
    @store.Dot,
    10,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[-156,-1.0106559991836548],
      #|[-153,-0.8653322458267212],
      #|[-144,-0.7649614214897156],
      #|[-150,-0.7066856622695923],
      #|[-186,-0.656197726726532],
      #|[-159,-0.446955144405365],
      #|[-192,-0.3452529311180115],
      #|[-180,-0.2584770917892456],
      #|[-162,0.02339429408311844],
      #|[-147,0.1100040078163147]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
  let result = graph.search(
    @types.vector_parse("[0.66671,0.043098,-0.597462]", 3, base=@types.Float16),
    @store.Dot,
    1000,
  )
  let expected = vector_search_fixture(
    (
      #|[
      #|[-156,-1.0106559991836548],
      #|[-153,-0.8653322458267212],
      #|[-144,-0.7649614214897156],
      #|[-150,-0.7066856622695923],
      #|[-186,-0.656197726726532],
      #|[-159,-0.446955144405365],
      #|[-192,-0.3452529311180115],
      #|[-180,-0.2584770917892456],
      #|[-162,0.02339429408311844],
      #|[-147,0.1100040078163147],
      #|[-195,0.1451050043106079],
      #|[-183,0.17445361614227295],
      #|[-177,0.3528851866722107],
      #|[-171,0.35870683193206787],
      #|[-201,0.37125927209854126],
      #|[-168,0.5292761325836182],
      #|[-174,0.6177939772605896],
      #|[-165,0.6725388765335083],
      #|[-198,0.7003652453422546],
      #|[-189,0.7816488742828369]
      #|]
    ),
  )
  assert_eq(result.map(c => (c.key, c.distance)), expected)
}

