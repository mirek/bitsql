      [
        15, 19, 20, 18, 14, 13, 2, 24, 28, 16, 29, 27, 6, 9, 11, 32, 30, 21, 12,
        31, 7,
      ],
    ),
    (26, [10, 7, 21, 4, 1, 11, 22, 29, 31, 32, 30, 18]),
    (27, [15, 24, 19, 9, 2, 28, 16, 18, 22, 30, 17, 4]),
    (28, [2, 15, 19, 24, 9, 27, 11, 7]),
