    let candidates : Array[@store.VectorCandidate] = []
    for (candidate_key, vector) in vectors {
      if candidate_key != key {
        candidates.push({
          key: candidate_key,
          vector,
          distance: source.distance(vector, "cosine"),
        })
      }
    }
    candidates.sort_by((a, b) => a.distance.compare(b.distance))
    assert_eq(@store.vector_prune(candidates, @store.Cosine), neighbors)
  }
}

///|
test "vector pruning oracle euclidean-resume-minimal" {
  let vectors : Array[(Int, @types.VectorData)] = [
    (
      8,
      @types.vector_parse(
        "[0.37713098526000977,0.5731580257415771,0.9196329712867737]", 3,
      ),
    ),
    (
      13,
      @types.vector_parse(
        "[0.6128379702568054,0.9313820004463196,0.49440398812294006]", 3,
      ),
    ),
    (
      39,
      @types.vector_parse(
        "[0.8385149836540222,0.7941470146179199,0.48321399092674255]", 3,
      ),
    ),
    (
      41,
      @types.vector_parse(
        "[0.9327980279922485,0.9374359846115112,0.7131230235099792]", 3,
      ),
    ),
    (
      83,
      @types.vector_parse(
        "[0.912738025188446,0.9465180039405823,0.5411999821662903]", 3,
      ),
    ),
  ]
  let expected : Array[(Int, Array[Int])] = [
    (8, [13]),
    (13, [39, 8]),
    (39, [83, 13, 8]),
    (41, [83, 8]),
    (83, [41, 39, 13]),
  ]
  for (key, neighbors) in expected {
    let source = vectors[vectors.search_by(v => v.0 == key).unwrap()].1
    let candidates : Array[@store.VectorCandidate] = []
    for (candidate_key, vector) in vectors {
      if candidate_key != key {
        candidates.push({
          key: candidate_key,
          vector,
          distance: source.distance(vector, "euclidean"),
        })
      }
    }
    candidates.sort_by((a, b) => a.distance.compare(b.distance))
    assert_eq(@store.vector_prune(candidates, @store.Euclidean), neighbors)
  }
}

