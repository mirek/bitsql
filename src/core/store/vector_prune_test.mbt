      ),
    ),
  ]
  let expected : Array[(Int, Array[Int])] = [
    (1, [19, 15, 10, 12, 3]),
    (2, [24, 30, 18, 31, 8]),
    (3, [4, 16, 32, 26]),
    (4, [11, 3, 27, 21, 30]),
    (5, [22, 21, 19, 23, 11, 14]),
    (6, [18, 17, 27, 31, 28, 8, 32, 14]),
    (7, [26, 16, 28, 13, 27, 3, 19]),
    (8, [29, 15, 2, 10, 9, 26, 20]),
    (9, [28, 14, 27, 21, 13, 8, 18]),
    (10, [14, 31, 13, 28, 1, 23, 8]),
    (11, [25, 4, 18, 28, 5, 23, 15]),
    (12, [26, 31, 28, 14, 25, 3]),
    (13, [24, 31, 10, 7, 16, 9, 14]),
    (14, [10, 9, 5, 1, 12, 25, 8, 15]),
    (15, [32, 1, 8, 11]),
    (16, [21, 7, 13, 24, 19, 3]),
    (17, [28, 18, 31, 29, 19]),
    (18, [6, 2, 25, 11, 23, 30, 17, 4]),
    (19, [1, 5, 16, 7, 8, 24]),
    (20, [22, 21, 19, 1, 9, 30]),
    (21, [5, 16, 9, 4, 3, 15]),
    (22, [20, 5, 19, 23, 16, 4]),
    (23, [18, 5, 10, 24, 32]),
    (24, [2, 13, 16, 23, 8, 19]),
    (25, [11, 30, 18, 17, 12, 22, 19]),
    (26, [12, 7, 13, 2, 27, 1]),
    (27, [29, 9, 6, 7, 4, 24]),
    (28, [9, 17, 11, 7, 10, 12, 21]),
    (29, [27, 8, 17, 4, 30, 20, 22]),
    (30, [2, 25, 18, 32, 4, 29, 22]),
    (31, [2, 13, 10, 17, 12, 15]),
    (32, [15, 30, 3, 20, 12]),
  ]
  for (key, neighbors) in expected {
    let source = vectors[vectors.search_by(v => v.0 == key).unwrap()].1
    let candidates : Array[@store.VectorCandidate] = []
    for (candidate_key, vector) in vectors {
      if candidate_key != key {
        candidates.push({
          key: candidate_key,
          vector,
          distance: source.distance(vector, "cosine"),
        })
      }
    }
    candidates.sort_by((a, b) => a.distance.compare(b.distance))
    assert_eq(@store.vector_prune(candidates, @store.Cosine), neighbors)
  }
}

