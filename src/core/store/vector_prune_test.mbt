    (14, [1, 4, 15, 2, 10, 13, 6]),
    (15, [1, 14, 4, 6, 9, 8]),
    (16, [8, 3, 14, 1, 4, 9, 7, 5]),
  ]
  for (key, neighbors) in expected {
    let source = vectors[vectors.search_by(v => v.0 == key).unwrap()].1
    let candidates : Array[@store.VectorCandidate] = []
    for (candidate_key, vector) in vectors {
      if candidate_key != key {
        candidates.push({
          key: candidate_key,
          vector,
          distance: source.distance(vector, "dot"),
        })
      }
    }
    candidates.sort_by((a, b) => a.distance.compare(b.distance))
    assert_eq(@store.vector_prune(candidates, @store.Dot), neighbors)
  }
}

