///|
test "vector pruning oracle dot-random-1-d3-n16" {
  let vectors : Array[(Int, @types.VectorData)] = [
    (1, @types.vector_parse("[-0.731272,0.694867,0.527549]", 3)),
    (2, @types.vector_parse("[-0.489862,-0.00913,-0.101018]", 3)),
    (3, @types.vector_parse("[0.303186,0.577447,-0.812281]", 3)),
    (4, @types.vector_parse("[-0.943305,0.67153,-0.134466]", 3)),
    (5, @types.vector_parse("[0.52456,-0.995788,-0.109226]", 3)),
    (6, @types.vector_parse("[0.44308,-0.542476,0.890541]", 3)),
    (7, @types.vector_parse("[0.802855,-0.93882,-0.949108]", 3)),
    (8, @types.vector_parse("[0.082825,0.878298,-0.237592]", 3)),
    (9, @types.vector_parse("[-0.566801,-0.155767,-0.941918]", 3)),
    (10, @types.vector_parse("[-0.556617,-0.124225,-0.008376]", 3)),
    (11, @types.vector_parse("[-0.533831,-0.538267,-0.562438]", 3)),
    (12, @types.vector_parse("[-0.080793,-0.420437,-0.957021]", 3)),
    (13, @types.vector_parse("[0.675156,0.112909,0.284589]", 3)),
    (14, @types.vector_parse("[-0.628187,0.985087,0.719893]", 3)),
    (15, @types.vector_parse("[-0.75822,-0.33461,0.442969]", 3)),
    (16, @types.vector_parse("[0.422384,0.872881,-0.155786]", 3)),
  ]
  let expected : Array[(Int, Array[Int])] = [
    (1, [14, 4, 8, 16, 9, 11]),
    (2, [4, 9, 1, 10, 14, 8, 3, 16, 7]),
    (3, [16, 8, 12, 7, 4, 13, 11, 1, 5]),
    (4, [14, 1, 9, 11, 3, 16, 12]),
    (5, [7, 12, 11, 9, 15, 10, 2]),
    (6, [5, 15, 7, 14, 10, 1, 4]),
    (7, [5, 9, 3, 6, 8]),
    (8, [16, 3, 9, 2, 12, 10]),
    (9, [12, 11, 7, 4, 15, 8, 5, 1, 16, 14]),
