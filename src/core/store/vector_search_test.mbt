    (1287, -0.0),
    (1290, -0.0),
    (1293, -0.0),
    (1296, -0.0),
  ]
  let found = @store.vector_search(
    nodes,
    -147,
    @types.vector_parse("[0,0,0]", 3),
    @store.Dot,
    1000,
  )
  // All source rows tie; oracle rebuilds can change the chosen keys.
  assert_eq(
    found.map(c => c.distance),
    expected.map(c => c.1),
    msg="dot-3-500 step 30",
  )
  let keys : Set[Int] = Set([])
  for candidate in found {
    assert_true(!keys.contains(candidate.key))
    assert_true(nodes.any(n => n.key == candidate.key))
    keys.add(candidate.key) |> ignore
  }
}

