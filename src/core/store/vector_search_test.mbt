  let found = @store.vector_search(
    nodes,
    -147,
    @types.vector_parse("[-0.210103,-0.486961,0.715329]", 3),
    @store.Dot,
    1000,
  )
  assert_eq(
    found.map(c => (c.key, c.distance)),
    expected,
    msg="dot-3-500 step 21",
  )
  let expected : Array[(Int, Double)] = []
  let found = @store.vector_search(
    nodes,
    -147,
    @types.vector_parse("[0,0,0]", 3),
    @store.Dot,
    0,
  )
  // All source rows tie; oracle rebuilds can change the chosen keys.
  assert_eq(
    found.map(c => c.distance),
    expected.map(c => c.1),
    msg="dot-3-500 step 22",
  )
  let keys : Set[Int] = Set([])
  for candidate in found {
    assert_true(!keys.contains(candidate.key))
    assert_true(nodes.any(n => n.key == candidate.key))
    keys.add(candidate.key) |> ignore
  }
  let expected : Array[(Int, Double)] = [(-195, -0.0)]
  let found = @store.vector_search(
    nodes,
    -147,
    @types.vector_parse("[0,0,0]", 3),
    @store.Dot,
    1,
  )
  // All source rows tie; oracle rebuilds can change the chosen keys.
  assert_eq(
    found.map(c => c.distance),
    expected.map(c => c.1),
    msg="dot-3-500 step 23",
  )
  let keys : Set[Int] = Set([])
  for candidate in found {
    assert_true(!keys.contains(candidate.key))
    assert_true(nodes.any(n => n.key == candidate.key))
    keys.add(candidate.key) |> ignore
  }
