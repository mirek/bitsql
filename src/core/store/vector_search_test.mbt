    (354, 1.3498562574386597),
    (75, 1.3601412773132324),
    (105, 1.3674489259719849),
    (72, 1.3675854206085205),
    (1287, 1.3694605827331543),
    (624, 1.3720577955245972),
    (1119, 1.374078631401062),
    (306, 1.3822685480117798),
    (1053, 1.3840374946594238),
    (-147, 1.3942674398422241),
    (996, 1.405661702156067),
    (663, 1.4177850484848022),
    (438, 1.4190282821655273),
    (201, 1.4294487237930298),
    (93, 1.429466724395752),
    (183, 1.448195219039917),
    (873, 1.4825717210769653),
    (297, 1.496640682220459),
    (1134, 1.4987565279006958),
    (807, 1.5053212642669678),
    (537, 1.5163354873657227),
    (141, 1.5194936990737915),
    (1041, 1.522919774055481),
    (657, 1.5250236988067627),
    (291, 1.5266188383102417),
    (885, 1.5315436124801636),
    (87, 1.537014365196228),
    (1209, 1.5397721529006958),
    (645, 1.5426585674285889),
    (267, 1.5484461784362793),
    (189, 1.563886046409607),
    (681, 1.5817753076553345),
    (339, 1.6237939596176147),
  ]
  let found = @store.vector_search(
    nodes,
    1251,
    @types.vector_parse("[0,0,0]", 3),
    @store.Euclidean,
    1000,
  )
  assert_eq(
    found.map(c => (c.key, c.distance)),
    expected,
    msg="euclidean-3-500 step 30",
  )
}

