// Generated by scripts/gen-vector-seed-tests.py from oracle captures.

///|
test "vector seed oracle cosine-d3-p30-middle" {
  let input : Array[(Int, @types.VectorData)] = [
    (1, @types.vector_parse("[-1073741824,1,0]", 3)),
    (2, @types.vector_parse("[1,1,0]", 3)),
    (3, @types.vector_parse("[1,1,0]", 3)),
    (4, @types.vector_parse("[1,1,0]", 3)),
    (5, @types.vector_parse("[1,1,0]", 3)),
    (6, @types.vector_parse("[1073741824,1,0]", 3)),
    (7, @types.vector_parse("[0,1,0]", 3)),
  ]
  input.sort_by((a, b) => a.0.compare(b.0))
  assert_eq(@store.vector_seed(input, @store.Cosine), Some(6))
}

