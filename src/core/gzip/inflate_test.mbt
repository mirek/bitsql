// Generated by .tmp/gen_dztest.py; outcomes captured from SQL Server (DECOMPRESS).

///|
fn unhex(s : String) -> Bytes {
  let v = (c : Int) => {
    if c >= 'a'.to_int() {
      c - 'a'.to_int() + 10
    } else {
      c - '0'.to_int()
    }
  }
  Bytes::makei(s.length() / 2, i => {
    (v(s[2 * i].to_int()) * 16 + v(s[2 * i + 1].to_int())).to_byte()
  })
}

///|
fn outcome(r : @gzip.Decompressed) -> String {
  match r {
    Data(b) => "D:" + b.length().to_string()
    Incomplete => "I"
    Corrupt => "C"
  }
}

///|
test "decompress no-trailer" {
  assert_eq(
    outcome(@gzip.gzip_decompress(unhex("1f8b0800000000000400cb48cdc9c90700"))),
    "D:5",
  )
}

///|
test "decompress crc-2bytes" {
  assert_eq(
    outcome(
      @gzip.gzip_decompress(unhex("1f8b0800000000000400cb48cdc9c9070086a6")),
    ),
    "D:5",
  )
}

