///|
fn rep(unit : Bytes, n : Int) -> Bytes {
  let out = @buffer.Buffer()
  for _ in 0..<n {
    out.write_bytes(unit)
  }
  out.to_bytes()
}

///|
fn hv(v : Int) -> Int {
  (v.to_int64() * 2654435761L % 4294967296L / 65536L).to_int()
}

///|
fn pseudo(n : Int, m : Int) -> Bytes {
  Bytes::makei(n, i => (97 + hv(i + 1) % m).to_byte())
}

///|
fn all_bytes(n : Int) -> Bytes {
  Bytes::makei(256 * n, i => (i % 256).to_byte())
}

///|
fn noise(n : Int) -> Bytes {
  Bytes::makei(n, v => ((hv(v * 7 + 3) >> 3) & 255).to_byte())
}

///|
fn hex(b : Bytes) -> String {
  let sb = StringBuilder()
  for x in b {
    let s = x.to_int().to_string(radix=16)
    if s.length() < 2 {
      sb.write_char('0')
    }
    sb.write_string(s)
  }
  sb.to_string()
}

///|
test "deflate abc" {
  let d = @gzip.deflate_raw(b"abc")
  assert_eq(hex(d), "4b4c4a0600")
}

///|
test "deflate hello" {
  let d = @gzip.deflate_raw(b"hello")
  assert_eq(hex(d), "cb48cdc9c90700")
}

///|
test "deflate x8000" {
  let d = @gzip.deflate_raw(rep(b"x", 8000))
  assert_eq(hex(d), "edc101010000008090dbcdef080a0000000000000018")
}

///|
test "deflate a100000" {
  let d = @gzip.deflate_raw(rep(b"a", 100000))
  assert_eq(d.length(), 115)
  assert_eq(@gzip.crc32(d), 3800369979U)
}

///|
test "deflate fox" {
  let d = @gzip.deflate_raw(
    rep(b"The quick brown fox jumps over the lazy dog. ", 20000),
  )
  assert_eq(d.length(), 2679)
  assert_eq(@gzip.crc32(d), 64599932U)
}

///|
test "deflate r3" {
  let d = @gzip.deflate_raw(pseudo(5000, 3))
  assert_eq(d.length(), 366)
  assert_eq(@gzip.crc32(d), 782762450U)
}

