///|
test "deflate bytes" {
  let d = @gzip.deflate_raw(all_bytes(40))
  assert_eq(d.length(), 366)
  assert_eq(@gzip.crc32(d), 298319538U)
}

///|
test "deflate noise" {
  let d = @gzip.deflate_raw(noise(70000))
