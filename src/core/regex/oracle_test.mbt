///|
fn capture_values(
  text : String,
  pattern : String,
) -> Array[Array[String?]] raise {
  let p = @regex.compile(pattern, "")
  let bytes = @utf8.encode(text)
  let rows : Array[Array[String?]] = []
  let mut at = 0
  while p.find(bytes, at, _ => ()) is Some(m) {
    rows.push(
      m.groups.map(g => {
        match g {
          None => None
          Some((a, b)) => Some(@utf8.decode(bytes[a:b]))
        }
      }),
    )
    let (a, b) = m.groups[0].unwrap()
    at = if a == b { @regex.next_boundary(bytes, b) } else { b }
  }
  rows
}

///|
test "oracle captures 0" {
  assert_eq(capture_values("ab12cd34", "([a-z]+)([0-9]+)"), [
    [Some("ab12"), Some("ab"), Some("12")],
    [Some("cd34"), Some("cd"), Some("34")],
  ])
}

///|
test "oracle captures 1" {
  assert_eq(capture_values("aaa", "(a|aa)+"), [[Some("aaa"), Some("a")]])
}

///|
test "oracle captures 2" {
  assert_eq(capture_values("aaa", "(aa|a)+"), [[Some("aaa"), Some("a")]])
}

///|
test "oracle captures 3" {
  assert_eq(capture_values("ab", "(a*)(b*)"), [
    [Some("ab"), Some("a"), Some("b")],
    [Some(""), Some(""), Some("")],
  ])
}

///|
test "oracle captures 4" {
  assert_eq(capture_values("a", "(a?)*"), [
    [Some("a"), Some("a")],
    [Some(""), Some("")],
  ])
}

///|
test "oracle captures 5" {
  assert_eq(capture_values("aa", "(a?)*"), [
    [Some("aa"), Some("a")],
    [Some(""), Some("")],
  ])
}

///|
test "oracle captures 6" {
  assert_eq(capture_values("ab", "(a)?(b)?"), [
    [Some("ab"), Some("a"), Some("b")],
    [Some(""), None, None],
  ])
}

///|
test "oracle captures 7" {
  assert_eq(capture_values("b", "(a)?(b)"), [[Some("b"), None, Some("b")]])
}

///|
test "oracle captures 8" {
  assert_eq(capture_values("abc", "((ab)|a)(c)"), [
    [Some("abc"), Some("ab"), Some("ab"), Some("c")],
  ])
}

///|
test "oracle captures 9" {
  assert_eq(capture_values("ab", "(a|ab)(b?)"), [
    [Some("ab"), Some("a"), Some("b")],
  ])
}

///|
test "oracle captures 10" {
  assert_eq(capture_values("ab", "(ab|a)(b?)"), [
    [Some("ab"), Some("ab"), Some("")],
  ])
}

///|
test "oracle captures 11" {
  assert_eq(capture_values("abbb", "(a)(b+?)"), [
    [Some("ab"), Some("a"), Some("b")],
  ])
}

///|
test "oracle captures 12" {
  assert_eq(capture_values("abb", "(a(b)*)"), [
    [Some("abb"), Some("abb"), Some("b")],
  ])
}

///|
test "oracle captures 13" {
  assert_eq(capture_values("aaa", "((a)*)"), [
    [Some("aaa"), Some("aaa"), Some("a")],
    [Some(""), Some(""), None],
  ])
}

///|
test "oracle captures 14" {
  assert_eq(capture_values("abc", "a.*?c"), [[Some("abc")]])
}

///|
test "oracle captures 15" {
  assert_eq(capture_values("abc", "a.*c"), [[Some("abc")]])
}

///|
test "oracle captures 16" {
  assert_eq(capture_values("aaa", "(a{1,2})(a*)"), [
    [Some("aaa"), Some("aa"), Some("a")],
  ])
}

///|
test "oracle captures 17" {
  assert_eq(capture_values("aaa", "(a{1,2}?)(a*)"), [
    [Some("aaa"), Some("a"), Some("aa")],
  ])
}

///|
test "oracle captures 18" {
  assert_eq(capture_values("abc", "(?i:a)(?-i:b)c"), [[Some("abc")]])
}

///|
test "oracle captures 19" {
  assert_eq(capture_values("abc", "a|"), [
    [Some("a")],
    [Some("")],
    [Some("")],
    [Some("")],
  ])
}
