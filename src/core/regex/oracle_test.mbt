// Generated by scripts/gen-regex-tests.py from real SQL Server captures.
// Do not hand-edit expectations.

///|
fn count_matches(text : String, pattern : String, flags : String) -> Int raise {
  let p = @regex.compile(pattern, flags)
  let bytes = @utf8.encode(text)
  let mut at = 0
  let mut count = 0
  while p.find(bytes, at, _ => ()) is Some(m) {
    let (start, end) = m.groups[0].unwrap()
    count += 1
    at = if start == end { @regex.next_boundary(bytes, end) } else { end }
  }
  count
}

///|
test "oracle count functions 0 0" {
  assert_eq(count_matches("Ab12cd34", "[0-9]+", ""), 2)
}

