    e => {
      assert_eq(e.number(), 19308)
      assert_eq(e.state(), 1)
      assert_eq(e.message(), "Missing ')' in the Pattern (.")
    }
  } noraise {
    _ => fail("Expected the oracle pattern error")
  }
}

