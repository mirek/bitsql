///|
test "native JSON construction storage json-binary-boundaries strings-repeat" {
  assert_eq(@types.json_constructed_storage_bytes("[\"x\",\"x\"]"), 36)
}

///|
test "native JSON construction storage json-binary-boundaries strings-different" {
  assert_eq(@types.json_constructed_storage_bytes("[\"x\",\"y\"]"), 36)
}

///|
test "native JSON construction storage json-binary-boundaries objects-repeat-key" {
  assert_eq(@types.json_constructed_storage_bytes("[{\"a\":1},{\"a\":2}]"), 65)
}

///|
test "native JSON construction storage json-binary-boundaries key-value-same" {
  assert_eq(@types.json_constructed_storage_bytes("{\"x\":\"x\"}"), 46)
}

///|
test "native JSON construction storage json-binary-boundaries nested-distinct" {
  assert_eq(@types.json_constructed_storage_bytes("{\"a\":{\"b\":1}}"), 64)
}

///|
test "native JSON construction storage json-binary-boundaries key-case" {
  assert_eq(@types.json_constructed_storage_bytes("{\"a\":{\"A\":1}}"), 64)
}

///|
test "native JSON construction storage json-binary-boundaries many-empties" {
  assert_eq(@types.json_constructed_storage_bytes("[[],{},[],{}]"), 38)
}

///|
test "native JSON construction storage json-binary-boundaries string-empty-repeat" {
  assert_eq(@types.json_constructed_storage_bytes("[\"\",\"\",\"\"]"), 34)
}

///|
test "native JSON construction storage json-binary-boundaries nested-null" {
  assert_eq(@types.json_constructed_storage_bytes("[[null]]"), 34)
}

///|
test "native JSON construction storage json-binary-boundaries numeric-values" {
  assert_eq(@types.json_constructed_storage_bytes("[1,2,3,4]"), 38)
}

///|
test "native JSON construction storage json-binary-boundaries string-controls" {
  assert_eq(
    @types.json_constructed_storage_bytes(
      "[\"\\u0000\",\"\\n\",\"\\\"\",\"\\\\\"]",
    ),
    50,
  )
}
