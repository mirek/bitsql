///|
test "vector oracle distance float16-distances distances-1-small 1" {
  let a = @types.vector_parse("[1.15504]", 1, base=Float16)
  let b = @types.vector_parse("[2.9169]", 1, base=Float16)
  assert_eq(a.distance(b, "dot"), -3.368795394897461)
  assert_eq(a.distance(b, "euclidean"), 1.7607421875)
  assert_eq(a.distance(b, "cosine"), 0.0)
  assert_eq(1.0 / a.distance(b, "cosine") < 0.0, false)
}

