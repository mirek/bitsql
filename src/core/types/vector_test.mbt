///|
test "vector oracle distance distance-special 12" {
  let a = @types.vector_parse("[1e20,0,0]", 3, base=Float32)
  let b = @types.vector_parse("[1e20,0,0]", 3, base=Float32)
  try a.distance(b, "dot") catch {
    e => {
      assert_eq(e.number(), 8115)
      assert_eq(e.state(), 2)
      assert_eq(
        e.message(),
        "Arithmetic overflow error converting expression to data type float.",
      )
    }
  } noraise {
    _ => fail("Expected SQL Server distance error")
  }
}

