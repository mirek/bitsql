    "[5.8112344,7.555794,3.056548,6.4547047,9.0248372,1.5442606,6.668788,-5.3133627]",
    8,
    base=Float16,
  )
  let b = @types.vector_parse(
    "[5.8722378,6.4996379,1.3222864,3.2550379,8.2950895,2.6931362,4.1486746,-4.6376469]",
    8,
    base=Float16,
  )
  assert_eq(a.distance(b, "dot"), -239.60231018066406)
  assert_eq(a.distance(b, "euclidean"), 4.795844554901123)
  assert_eq(a.distance(b, "cosine"), 0.028455793857574463)
}

