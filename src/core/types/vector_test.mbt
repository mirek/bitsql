///|
test "vector oracle norm-extremes 3" {
  let v = @types.vector_parse("[1e20,1e20,1e20,1e20,1e20,1e20,1e20,1e20]", 8)
  try v.norm("norm2") catch {
    e => {
      assert_eq(e.number(), 8115)
      assert_eq(e.state(), 2)
      assert_eq(
        e.message(),
        "Arithmetic overflow error converting expression to data type float.",
      )
    }
  } noraise {
    _ => fail("Expected SQL Server norm error")
  }
}

