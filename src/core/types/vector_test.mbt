///|
test "vector oracle distance distance-special 0" {
  let a = @types.vector_parse("[0,0,0]", 3, base=Float32)
  let b = @types.vector_parse("[0,0,0]", 3, base=Float32)
  assert_eq(a.distance(b, "dot"), -0.0)
  assert_eq(1.0 / a.distance(b, "dot") < 0.0, true)
}

///|
test "vector oracle distance distance-special 1" {
  let a = @types.vector_parse("[0,0,0]", 3, base=Float32)
  let b = @types.vector_parse("[0,0,0]", 3, base=Float32)
  assert_eq(a.distance(b, "euclidean"), 0.0)
  assert_eq(1.0 / a.distance(b, "euclidean") < 0.0, false)
}

