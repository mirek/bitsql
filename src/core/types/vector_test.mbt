    "[1.0000000e+000,1.0000000e-011,-2.6999999e-010,3.0000000e-010,-1.0000000e+000,2.0000000e-011,1.0000000e-030,1.0000000e+000,1.0000000e-011,-2.6999999e-010,3.0000000e-010,-1.0000000e+000,2.0000000e-011,1.0000000e-030,1.0000000e+000,1.0000000e-011,-2.6999999e-010,3.0000000e-010,-1.0000000e+000,2.0000000e-011,1.0000000e-030,1.0000000e+000,1.0000000e-011,-2.6999999e-010,3.0000000e-010,-1.0000000e+000,2.0000000e-011,1.0000000e-030,1.0000000e+000,1.0000000e-011,-2.6999999e-010,3.0000000e-010,-1.0000000e+000,2.0000000e-011,1.0000000e-030,1.0000000e+000,1.0000000e-011,-2.6999999e-010,3.0000000e-010,-1.0000000e+000,2.0000000e-011,1.0000000e-030,1.0000000e+000,1.0000000e-011,-2.6999999e-010,3.0000000e-010,-1.0000000e+000,2.0000000e-011,1.0000000e-030,1.0000000e+000,1.0000000e-011,-2.6999999e-010,3.0000000e-010,-1.0000000e+000,2.0000000e-011,1.0000000e-030,1.0000000e+000,1.0000000e-011,-2.6999999e-010,3.0000000e-010,-1.0000000e+000,2.0000000e-011,1.0000000e-030,1.0000000e+000,1.0000000e-011]",
  )
}

///|
test "vector oracle norm-extremes 0" {
  let v = @types.vector_parse("[1e20,1e20,1e20,1e20,1e20,1e20,1e20]", 7)
