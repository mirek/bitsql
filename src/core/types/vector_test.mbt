///|
test "vector oracle norm rounding 1-small" {
  let v0 = @types.vector_parse("[1.15504]", 1)
  assert_eq(v0.norm("norm1"), 1.1550400257110596)
  assert_eq(v0.norm("norm2"), 1.1550400257110596)
  assert_eq(v0.norm("norminf"), 1.1550400257110596)
  let v1 = @types.vector_parse("[2.9169]", 1)
  assert_eq(v1.norm("norm1"), 2.9168999195098877)
  assert_eq(v1.norm("norm2"), 2.9168999195098877)
  assert_eq(v1.norm("norminf"), 2.9168999195098877)
}

