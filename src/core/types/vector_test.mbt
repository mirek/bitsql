  let a = @types.vector_parse(
    "[-2.2477447,-9.6779083,5.6179468,0.1775527,-0.1693953,-4.0324789,7.4492051,-7.201826,-9.1535836]",
    9,
    base=Float32,
  )
  let b = @types.vector_parse(
    "[2.7166932,9.1358383,-3.28777,-1.3360669,1.5408321,3.8744256,-6.0080819,7.4677654,6.4984645]",
    9,
    base=Float32,
  )
  assert_eq(a.distance(b, "dot"), 287.1357421875)
  assert_eq(a.distance(b, "euclidean"), 34.16038131713867)
  assert_eq(a.distance(b, "cosine"), 1.9785754680633545)
}

