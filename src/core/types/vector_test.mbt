///|
test "vector oracle norms 0" {
  let v = @types.vector_parse("[1,2,3]", 3)
  assert_eq(v.norm("norm1"), 6.0)
  assert_eq(
    v.normalize("norm1").to_text(),
    "[1.6666667e-001,3.3333334e-001,5.0000000e-001]",
  )
  assert_eq(v.norm("norm2"), 3.7416573867739413)
  assert_eq(
    v.normalize("norm2").to_text(),
    "[2.6726124e-001,5.3452247e-001,8.0178368e-001]",
  )
  assert_eq(v.norm("norminf"), 3.0)
  assert_eq(
    v.normalize("norminf").to_text(),
    "[3.3333334e-001,6.6666669e-001,1.0000000e+000]",
  )
}

