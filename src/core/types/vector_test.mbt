  let v = @types.vector_parse("[1e10,0.1,-2.7,3,-1e10,0.2,1e-20,1e10]", 8)
  assert_eq(v.norm("norm1"), 30000000006.000004)
  assert_eq(
    v.normalize("norm1").to_text(),
    "[3.3333331e-001,3.3333332e-012,-9.0000001e-011,9.9999994e-011,-3.3333331e-001,6.6666664e-012,3.3333331e-031,3.3333331e-001]",
  )
  assert_eq(v.norm("norm2"), 17320508249.24786)
  assert_eq(
    v.normalize("norm2").to_text(),
    "[5.7735032e-001,5.7735032e-012,-1.5588458e-010,1.7320509e-010,-5.7735032e-001,1.1547006e-011,5.7735026e-031,5.7735032e-001]",
  )
  assert_eq(v.norm("norminf"), 10000000000.0)
  assert_eq(
    v.normalize("norminf").to_text(),
    "[1.0000000e+000,1.0000000e-011,-2.6999999e-010,3.0000000e-010,-1.0000000e+000,2.0000000e-011,1.0000000e-030,1.0000000e+000]",
  )
}

