///|
test "vector oracle distance distances 1-small 0" {
  let a = @types.vector_parse("[1.15504]", 1, base=Float32)
  let b = @types.vector_parse("[2.9169]", 1, base=Float32)
  assert_eq(a.distance(b, "dot"), -3.369136095046997)
  assert_eq(a.distance(b, "euclidean"), 1.7618598937988281)
  assert_eq(a.distance(b, "cosine"), 0.0)
  assert_eq(1.0 / a.distance(b, "cosine") < 0.0, false)
}

///|
test "vector oracle distance distances 1-mixed 0" {
  let a = @types.vector_parse("[-4.4788000000000003e-11]", 1, base=Float32)
  let b = @types.vector_parse("[0.58577]", 1, base=Float32)
  assert_eq(a.distance(b, "dot"), 2.623546692392953e-11)
  assert_eq(a.distance(b, "euclidean"), 0.5857700109481812)
  assert_eq(a.distance(b, "cosine"), 2.0)
}

///|
test "vector oracle distance distances 2-small 0" {
  let a = @types.vector_parse("[9.46584,1.39418]", 2, base=Float32)
  let b = @types.vector_parse("[-8.68429,-1.98254]", 2, base=Float32)
  assert_eq(a.distance(b, "dot"), 84.9681167602539)
  assert_eq(a.distance(b, "euclidean"), 18.46156883239746)
  assert_eq(a.distance(b, "cosine"), 1.9969429969787598)
}

///|
test "vector oracle distance distances 2-mixed 0" {
  let a = @types.vector_parse("[-9.13297e-10,9.64008e-10]", 2, base=Float32)
  let b = @types.vector_parse(
    "[-17719600000.0,-94426100000.0]",
    2,
    base=Float32,
  )
  assert_eq(a.distance(b, "dot"), 74.8442611694336)
  assert_eq(a.distance(b, "euclidean"), 96074309632.0)
  assert_eq(a.distance(b, "cosine"), 1.586641788482666)
}

///|
test "vector oracle distance distances 3-small 0" {
  let a = @types.vector_parse("[-8.66358,8.00941,5.39351]", 3, base=Float32)
  let b = @types.vector_parse("[-9.46753,-5.44136,5.72151]", 3, base=Float32)
  assert_eq(a.distance(b, "dot"), -69.29965209960938)
  assert_eq(a.distance(b, "euclidean"), 13.478765487670898)
  assert_eq(a.distance(b, "cosine"), 0.5666881203651428)
}

///|
test "vector oracle distance distances 3-mixed 0" {
  let a = @types.vector_parse("[5.63597,8.42561,3.9465e-11]", 3, base=Float32)
  let b = @types.vector_parse(
    "[19134300000.0,-6.03794e-10,-5.13096e-10]",
    3,
    base=Float32,
  )
  assert_eq(a.distance(b, "dot"), -107840339968.0)
  assert_eq(a.distance(b, "euclidean"), 19134300160.0)
  assert_eq(a.distance(b, "cosine"), 0.4440099000930786)
}

///|
test "vector oracle distance distances 4-small 0" {
  let a = @types.vector_parse(
    "[-7.6787,-7.27774,9.37927,-8.2681]",
    4,
    base=Float32,
  )
  let b = @types.vector_parse(
    "[1.72559,5.30234,-1.14412,8.79802]",
    4,
    base=Float32,
  )
