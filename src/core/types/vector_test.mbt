///|
test "vector oracle float16 input 1" {
  let v = @types.vector_parse("[1,2,3]", 3, base=Float16)
  assert_eq(v.to_text(), "[1.0000000e+000,2.0000000e+000,3.0000000e+000]")
  assert_eq(8 + v.base().bytes() * v.dimensions(), 14)
  assert_eq(v.base().name(), "float16")
}

///|
test "vector oracle float16 input 2" {
  let v = @types.vector_parse("[0.1,-1.23456,65504]", 3, base=Float16)
  assert_eq(v.to_text(), "[9.9975586e-002,-1.2343750e+000,6.5504000e+004]")
  assert_eq(8 + v.base().bytes() * v.dimensions(), 14)
  assert_eq(v.base().name(), "float16")
}

///|
test "vector oracle float16 input 3" {
  let v = @types.vector_parse("[1e-8,1e-7,-0]", 3, base=Float16)
  assert_eq(v.to_text(), "[0.0000000e+000,1.1920929e-007,0.0000000e+000]")
  assert_eq(8 + v.base().bytes() * v.dimensions(), 14)
  assert_eq(v.base().name(), "float16")
}

///|
test "vector oracle float16 input 4" {
  let v = @types.vector_parse("[65519,0,0]", 3, base=Float16)
  assert_eq(v.to_text(), "[6.5504000e+004,0.0000000e+000,0.0000000e+000]")
  assert_eq(8 + v.base().bytes() * v.dimensions(), 14)
  assert_eq(v.base().name(), "float16")
}

///|
test "vector oracle float16 input 5" {
  try @types.vector_parse("[65520,0,0]", 3, base=Float16) catch {
    e => {
      assert_eq(e.number(), 42241)
      assert_eq(e.state(), 2)
      assert_eq(
        e.message(),
        "Input JSON contains out-of-range values for float16.",
      )
    }
  } noraise {
    _ => fail("Expected SQL Server float16 input error")
  }
}

///|
test "vector oracle float16 input 6" {
  try @types.vector_parse("[65536,0,0]", 3, base=Float16) catch {
    e => {
      assert_eq(e.number(), 42241)
      assert_eq(e.state(), 2)
      assert_eq(
        e.message(),
        "Input JSON contains out-of-range values for float16.",
      )
    }
  } noraise {
    _ => fail("Expected SQL Server float16 input error")
  }
}

