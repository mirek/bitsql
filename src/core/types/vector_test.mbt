    "[-6.0634856,5.3530151,-6.9059142,8.7724856,9.6359493,0.2882892,-7.3326294,9.6627174,-6.0740087,6.3583807,-3.0010021,0.9137012,-2.6313502,-1.8085565,-9.8884232,4.1786555,-9.1921725,6.4616903,-4.3967234,-7.9118406,1.0006155,8.910708,6.8437608,-6.1415989,7.2550581,1.2331707,-3.5045177,-1.6812591,-5.2273875,-6.0784555,2.3689854,-5.5432158,-0.0783438]",
    33,
    base=Float32,
  )
  let b = @types.vector_parse(
    "[6.8060059,-3.7396043,4.0653087,-8.6829509,-9.3785757,-1.347073,3.9174989,-9.1639346,3.9690852,-6.4801747,3.4007875,-0.3269218,1.5550367,0.1775136,8.5668294,-2.8913296,9.2255438,-5.748111,5.0209196,5.988022,0.170304,-7.0460534,-3.9327192,4.7646701,-4.4061046,0.5463693,4.6436333,1.0119621,5.3209815,5.4742501,-3.1655522,4.0151272,0.8400677]",
