// Windows time zones as SQL Server's AT TIME ZONE and sys.time_zone_info see
// them. The tables in timezone_data.mbt are generated by
// scripts/gen-timezones.py from SQL Server's own answers
// (scripts/timezones/sqlserver-timezones.json); the script checks this
// model (it carries a Python twin of every function here) against every
// scanned transition and wall-time probe.
//
// A zone's UTC timeline is a list of segments, each a fixed offset or an
// annual Windows rule (standard/daylight offsets and two "n-th weekday of a
// month at a wall-clock time" changes). The first segment starts at
// -infinity and the last one never ends: SQL Server extrapolates the first
// and last yearly rules over the whole datetime2 range.

///|
/// Start of a zone's first segment (-infinity).
let tz_neg_inf : Int64 = -9_223_372_036_854_775_807L - 1L

///|
/// Number of zones in sys.time_zone_info.
pub fn tz_count() -> Int {
  tz_names.length()
}

///|
/// Name of zone `zone` (catalog order).
pub fn tz_name(zone : Int) -> String {
  tz_names[zone]
}

///|
/// Looks a zone name up the way AT TIME ZONE does (captured in msduck
/// at-time-zone-names and corpus/timezone): ASCII case-insensitive (plus the Kelvin sign), U+0000
/// ignored anywhere, everything else exact (spaces, accents, width,
/// non-ASCII case).
pub fn tz_lookup(name : String) -> Int? {
  let key = StringBuilder()
  for i in 0..<name.length() {
    let c = name.code_unit_at(i).to_int()
    if c == 0 {
      continue
    }
    // U+212A KELVIN SIGN lower-cases to 'k' and matches (captured); other
    // non-ASCII letters (ſ, ı, İ, fullwidth) do not
    let c = if c >= 'a'.to_int() && c <= 'z'.to_int() {
      c - 32
    } else if c == 0x212A {
      'K'.to_int()
    } else {
      c
    }
    key.write_char(c.unsafe_to_char())
  }
  let key = key.to_string()
  for i, n in tz_names {
    if n.length() == key.length() && n.to_upper() == key {
      return Some(i)
    }
  }
  None
}

///|
fn floor_div(a : Int64, b : Int64) -> Int64 {
  let q = a / b
  if a % b != 0L && a < 0L {
    q - 1L
  } else {
    q
  }
}

///|
fn tz_year_of(ticks : Int64) -> Int {
  civil_from_days(floor_div(ticks, TICKS_PER_DAY).to_int()).0
}

///|
fn tz_year_start(year : Int) -> Int64 {
  days_from_civil(year, 1, 1).to_int64() * TICKS_PER_DAY
}

///|
/// Day number of the `week`-th (5 = last) weekday `wd` (0 = Sunday) of
/// `month` in `year`. 0001-01-01 is a Monday.
fn tz_spec_day(year : Int, month : Int, week : Int, wd : Int) -> Int {
  let first = days_from_civil(year, month, 1)
  let mut d = first + (wd - (first + 1) % 7 + 7) % 7 + (week - 1) * 7
  let end = first +
    (match month {
      2 => if is_leap(year) { 29 } else { 28 }
      4 | 6 | 9 | 11 => 30
      _ => 31
    })
  while d >= end {
    d -= 7
  }
  d
}

///|
/// (DST start, DST end) UTC instants of rule `r` in rule year `year`.
fn tz_rule_bounds(r : Int, year : Int) -> (Int64, Int64) {
  let (std, dst, sm, sw, sd, stod, em, ew, ed, etod) = tz_rules[r]
  let s = tz_spec_day(year, sm, sw, sd).to_int64() * TICKS_PER_DAY +
    stod -
    std.to_int64() * TICKS_PER_MINUTE
  let e = tz_spec_day(year, em, ew, ed).to_int64() * TICKS_PER_DAY +
    etod -
    dst.to_int64() * TICKS_PER_MINUTE
  (s, e)
}

///|
fn tz_clamp_year(y : Int) -> Int {
  if y < 1 {
    1
  } else if y > 9999 {
    9999
  } else {
    y
  }
}

///|
/// (offset, daylight?) of rule `r` at `utc`, the way SQL Server decides: the
/// rule year Y is the year of the standard-time wall clock (utc + standard
/// offset); the daylight-time wall clock (utc + daylight offset), moved into
/// year Y (its own year is dropped), is compared with year Y's DST end (a
/// daylight wall time) and DST start (a standard wall time, shifted into
/// daylight time). In the hours where the two wall clocks are in different
/// years this reproduces SQL Server's odd results (Central Brazilian
/// Standard Time: DST end at 1903-01-01 04:00 UTC instead of 03:00, a
/// one-hour standard-time blip at 1904-01-01 03:00 UTC).
fn tz_rule_offset(r : Int, utc : Int64) -> (Int, Bool) {
  let (std, dst, sm, sw, sd, stod, em, ew, ed, etod) = tz_rules[r]
  let y = tz_clamp_year(tz_year_of(utc + std.to_int64() * TICKS_PER_MINUTE))
  let d = utc + dst.to_int64() * TICKS_PER_MINUTE
  let days = floor_div(d, TICKS_PER_DAY)
  let (_, m, day) = civil_from_days(days.to_int())
  let wall = days_from_civil(y, m, day).to_int64() * TICKS_PER_DAY +
    (d - days * TICKS_PER_DAY)
  let start = tz_spec_day(y, sm, sw, sd).to_int64() * TICKS_PER_DAY +
    stod +
    (dst - std).to_int64() * TICKS_PER_MINUTE
  let end = tz_spec_day(y, em, ew, ed).to_int64() * TICKS_PER_DAY + etod
  let inside = if sm < em {
    start <= wall && wall < end
  } else {
    wall < end || wall >= start
  }
  if inside {
    (dst, std != dst)
  } else {
    (std, false)
  }
}

///|
/// Index into `tz_segments` of the segment of `zone` holding `utc`.
fn tz_segment(zone : Int, utc : Int64) -> Int {
  let mut lo = tz_first[zone]
  let mut hi = tz_first[zone + 1] - 1
  while lo < hi {
    let mid = (lo + hi + 1) / 2
    if tz_segments[mid].0 <= utc {
      lo = mid
    } else {
      hi = mid - 1
    }
  }
  lo
}

///|
/// (offset in minutes, daylight saving time?) of `zone` at UTC instant `utc`
/// (100 ns ticks since 0001-01-01).
pub fn tz_offset_info(zone : Int, utc : Int64) -> (Int, Bool) {
  let (_, fixed, r, daylight) = tz_segments[tz_segment(zone, utc)]
  if r < 0 {
    (fixed, daylight)
  } else {
    tz_rule_offset(r, utc)
  }
}

///|
/// Offset in minutes of `zone` at UTC instant `utc`.
pub fn tz_offset_at(zone : Int, utc : Int64) -> Int {
  tz_offset_info(zone, utc).0
}

///|
/// Offset changes of `zone` with instant in (lo, hi], sorted:
/// (instant, offset before, offset after).
fn tz_transitions(
  zone : Int,
  lo : Int64,
  hi : Int64,
) -> Array[(Int64, Int, Int)] {
  let cands : Array[Int64] = []
  let last = tz_first[zone + 1] - 1
  for i in tz_segment(zone, lo + 1)..<=tz_segment(zone, hi) {
    let (start, _, r, _) = tz_segments[i]
    let end = if i < last { tz_segments[i + 1].0 } else { hi + 1L }
    let a = if start > lo + 1L { start } else { lo + 1L }
    let b = if end < hi + 1L { end } else { hi + 1L }
    if a >= b {
      continue
    }
    if start == a {
      cands.push(a)
    }
    if r >= 0 {
      let std = tz_rules[r].0.to_int64() * TICKS_PER_MINUTE
      let dst = tz_rules[r].1.to_int64() * TICKS_PER_MINUTE
      let y0 = tz_year_of(a) - 1
      let y1 = tz_year_of(b - 1L) + 1
      for
        y in (if y0 < 1 { 1 } else { y0 })..<=(if y1 > 9999 {
          9999
        } else {
          y1
        }) {
        let (s, e) = tz_rule_bounds(r, y)
        let jan1 = tz_year_start(y)
        for t in [s, e, jan1 - std, jan1 - dst] {
          if t >= a && t < b {
            cands.push(t)
          }
        }
      }
    }
  }
  cands.sort()
  let out = []
  let mut prev = tz_neg_inf
  for t in cands {
    if t == prev {
      continue
    }
    prev = t
    let before = tz_offset_at(zone, t - 1L)
    let after = tz_offset_at(zone, t)
    if before != after {
      out.push((t, before, after))
    }
  }
  out
}

///|
/// Whether SQL Server reads the wall times of `year` repeated or skipped by
/// `zone`'s change at `t` in the offset after the change (generated
/// exceptions; a range spanning a new year can differ on each side).
fn tz_after_pick(zone : Int, t : Int64, year : Int) -> Bool {
  tz_after_picks.iter().any(p => p.0 == zone && p.1 == t && p.2 == year)
}

///|
/// Whether wall input in wall-clock year `year` of `zone` is resolved in a
/// way this model does not reproduce.
pub fn tz_local_unsupported(zone : Int, year : Int) -> Bool {
  tz_unsupported_local_years.iter().any(p => p.0 == zone && p.1 == year)
}

///|
/// Resolves a wall-clock time of `zone` (wall ticks) as SQL Server does:
/// (UTC ticks, offset shown). A wall time that a change repeats or skips is
/// read in the offset before the change: for daylight saving time repeated
/// times are daylight time (the earlier instant) and skipped ones are read
/// in standard time, landing after the change (02:30 → 03:30 -07:00). The
/// generated `tz_after_picks` changes (mostly one-off base offset changes)
/// read them in the offset after the change instead.
pub fn tz_local_to_utc(zone : Int, wall : Int64) -> (Int64, Int) {
  let span = 1000L * TICKS_PER_MINUTE
  for tr in tz_transitions(zone, wall - span, wall + span) {
    let (t, b, a) = tr
    let wb = t + b.to_int64() * TICKS_PER_MINUTE
    let wa = t + a.to_int64() * TICKS_PER_MINUTE
    let lo = if wb < wa { wb } else { wa }
    let hi = if wb < wa { wa } else { wb }
    if wall >= lo && wall < hi {
      let o = if tz_after_pick(zone, t, tz_year_of(wall)) { a } else { b }
      let utc = wall - o.to_int64() * TICKS_PER_MINUTE
      return (utc, tz_offset_at(zone, utc))
    }
  }
  let mut o = tz_offset_at(
    zone,
    wall - tz_offset_at(zone, wall - span).to_int64() * TICKS_PER_MINUTE,
  )
  if tz_offset_at(zone, wall - o.to_int64() * TICKS_PER_MINUTE) != o {
    o = tz_offset_at(
      zone,
      wall - tz_offset_at(zone, wall + span).to_int64() * TICKS_PER_MINUTE,
    )
  }
  (wall - o.to_int64() * TICKS_PER_MINUTE, o)
}
