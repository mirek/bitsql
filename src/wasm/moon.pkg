import {
  "mirek/bitsql/core/engine",
  "mirek/bitsql/core/tds",
  "mirek/bitsql/tlscert",
  "moonbitlang/core/encoding/utf8",
}

supported_targets = "+wasm-gc"

options(
  link: {
    "wasm-gc": {
      "exports": [ "reserve", "create", "handle", "version", "tls_identity" ],
      "export-memory-name": "memory",
      "memory-limits": { "min": 1, "max": 65536 },
    },
  },
)
